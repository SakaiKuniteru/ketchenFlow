<link rel="stylesheet" href="/assets/css/pages/thuc-don/form.css">
<link rel="stylesheet" href="/assets/css/pages/thuc-don/chi-tiet.css">

<main class="td-page td-detail" data-thuc-don-page data-page-mode="detail" data-thuc-don-id="{{thucDonId}}">

    <div class="td-topline">

        <a href="/thuc-don/danh-sach-thuc-don" class="td-back-link">

            <i class="fa-solid fa-arrow-left"></i>

            Quay lại

        </a>

    </div>


    <header class="td-page-header">

        <div>

            <h1>
                Chi tiết thực đơn
            </h1>

            <p>
                Xem thông tin chi tiết và nội dung thực đơn
            </p>

        </div>


        <div class="td-page-actions">

            <a class="td-btn td-btn--outline" href="/thuc-don/cap-nhat-thong-tin-thuc-don/{{thucDonId}}"
                data-detail-edit hidden>

                <i class="fa-regular fa-pen-to-square"></i>

                Chỉnh sửa

            </a>


            <button class="td-btn td-btn--success" data-detail-approve hidden>

                Duyệt

            </button>


            <button class="td-btn td-btn--warning" data-detail-unapprove hidden>

                Hủy duyệt

            </button>


            <button class="td-btn td-btn--danger" data-detail-cancel hidden>

                Hủy thực đơn

            </button>


            <button class="td-btn td-btn--outline" data-detail-restore hidden>

                Hoàn hủy

            </button>

        </div>

    </header>

    <div class="td-form" data-thuc-don-form data-form-mode="detail">
        {{> thuc-don/form-thong-tin-chung}}
        {{> thuc-don/form-noi-dung}}
    </div>
    {{> catalog/no-permission}}
</main>

<script src="/assets/js/pages/thuc-don/permission.js"></script>
<script src="/assets/js/pages/thuc-don/form.js"></script>
<script src="/assets/js/pages/thuc-don/api.js"></script>
<script src="/assets/js/pages/thuc-don/options.js"></script>
<script src="/assets/js/pages/thuc-don/chi-tiet.js"></script>