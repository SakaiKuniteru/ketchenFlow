<link rel="stylesheet" href="/assets/css/pages/thuc-don/form.css">
<link rel="stylesheet" href="/assets/css/pages/thuc-don/form-editor.css">

<main class="td-page td-editor" data-thuc-don-page data-page-mode="update" data-thuc-don-id="{{thucDonId}}">

    <div class="td-topline">

        <button type="button" class="td-back-link" data-form-back>

            <i class="fa-solid fa-arrow-left"></i>

            Quay lại

        </button>

    </div>


    <header class="td-page-header">

        <div>

            <h1>
                Cập nhật thực đơn
            </h1>

            <p>
                Cập nhật thông tin và nội dung thực đơn
            </p>

        </div>


        <div class="td-page-actions">

            <button class="td-btn td-responsive-action" type="button" data-form-cancel title="Hủy bỏ"
                aria-label="Hủy bỏ" hidden>

                <i class="fa-solid fa-xmark" aria-hidden="true">
                </i>

                <span class="td-responsive-action__label">
                    Hủy bỏ
                </span>

            </button>


            <button class="
                td-btn
                td-btn--primary
                td-responsive-action
            " type="button" data-form-save title="Lưu" aria-label="Lưu" hidden>

                <i class="fa-regular fa-floppy-disk" aria-hidden="true">
                </i>

                <span class="td-responsive-action__label">
                    Lưu
                </span>

            </button>


            <button class="
                td-btn
                td-btn--success
                td-responsive-action
            " type="button" data-form-save-approve title="Lưu & duyệt" aria-label="Lưu & duyệt" hidden>

                <i class="fa-solid fa-check-double" aria-hidden="true">
                </i>

                <span class="td-responsive-action__label">
                    Lưu & duyệt
                </span>

            </button>

        </div>

    </header>


    <div class="td-form" data-thuc-don-form data-form-mode="update">
        {{> thuc-don/form-thong-tin-chung}}
        {{> thuc-don/form-noi-dung}}
    </div>
    {{> thuc-don/modal-ngay}}
    {{> thuc-don/modal-nhom}}
    {{> thuc-don/modal-mon}}
    {{> catalog/no-permission}}

</main>

<script src="/assets/js/components/checkbox.js"></script>
<script src="/assets/js/pages/thuc-don/permission.js"></script>
<script src="/assets/js/pages/thuc-don/api.js"></script>
<script src="/assets/js/pages/thuc-don/options.js"></script>
<script src="/assets/js/pages/thuc-don/form.js"></script>
<script src="/assets/js/pages/thuc-don/payload.js"></script>
<script src="/assets/js/pages/thuc-don/content-editor.js"></script>
<script src="/assets/js/pages/thuc-don/editor.js"></script>
<script src="/assets/js/pages/thuc-don/cap-nhat.js"></script>