<link rel="stylesheet" href="/assets/css/pages/thuc-don/form.css">
<link rel="stylesheet" href="/assets/css/pages/thuc-don/form-editor.css">

<main class="td-page td-editor" data-thuc-don-page data-page-mode="create">

    <div class="td-topline">

        <button type="button" class="td-back-link" data-form-back>

            <i class="fa-solid fa-arrow-left"></i>

            Quay lại

        </button>

    </div>


    <header class="td-page-header">

        <div>

            <h1>
                Tạo thực đơn mới
            </h1>

            <p>
                Thiết lập thông tin và xây dựng nội dung thực đơn
            </p>

        </div>


        <div class="td-page-actions">

            <button class="td-btn" type="button" data-form-cancel>

                <i class="fa-solid fa-xmark"></i>

                Hủy bỏ

            </button>


            <button class="td-btn td-btn--primary" type="button" data-form-save>

                <i class="fa-solid fa-check"></i>

                Thêm mới

            </button>

        </div>

    </header>


    <div class="td-form" data-thuc-don-form data-form-mode="create">

        {{> thuc-don/form-thong-tin-chung}}

        {{> thuc-don/form-noi-dung}}

    </div>


    {{> thuc-don/modal-ngay}}

    {{> thuc-don/modal-nhom}}

    {{> thuc-don/modal-mon}}


    <footer class="td-summary-footer">

        <div>

            <strong data-summary-count>
                0 ngày · 0 nhóm · 0 món
            </strong>

            <span data-summary-quantity>
                Tổng định lượng: 0
            </span>

        </div>


        <div>

            <button class="td-btn" type="button" data-form-cancel>

                Hủy bỏ

            </button>


            <button class="td-btn td-btn--primary" type="button" data-form-save>

                Thêm mới

            </button>

        </div>

    </footer>
    {{> catalog/no-permission}}
</main>

<script src="/assets/js/components/checkbox.js"></script>
<script src="/assets/js/pages/thuc-don/permission.js"></script>
<script src="/assets/js/pages/thuc-don/api.js"></script>
<script src="/assets/js/pages/thuc-don/options.js"></script>
<script src="/assets/js/pages/thuc-don/form.js"></script>
<script src="/assets/js/pages/thuc-don/payload.js"></script>
<script src="/assets/js/pages/thuc-don/content-editor.js"></script>
<script src="/assets/js/pages/thuc-don/editor.js"></script>
<script src="/assets/js/pages/thuc-don/them-moi.js"></script>