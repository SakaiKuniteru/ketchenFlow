{{#> dat-hang/dung-chung
    type="page-shell"
    page="catalog"
}}
    <div class="order-catalog-layout">
        <main class="order-catalog-main">
            <div class="order-catalog-heading">
                {{> dat-hang/dung-chung
                    type="page-header"
                    title="Đặt món"
                    description="Đồ ăn, đồ uống và dịch vụ cho một ngày làm việc trọn vẹn."
                }}

                <div class="order-promo">
                    <div>
                        <strong>Đặt nhanh<br>Tiện lợi mỗi ngày</strong>
                        <span>Món ngon · Đồ uống · Dịch vụ</span>
                    </div>

                    <i class="fa-solid fa-bowl-food"></i>
                </div>
            </div>

            {{> dat-hang/dat-mon type="search"}}

            <div class="order-category-tabs" data-category-tabs></div>

            <div class="order-product-grid" data-product-grid>
                {{> dat-hang/dung-chung type="loading"}}
            </div>

            <div class="order-pagination" data-catalog-pagination></div>
        </main>

        <aside class="order-cart-panel" data-cart-panel>
            {{> dat-hang/gio-hang type="empty"}}
        </aside>
    </div>

    {{> dat-hang/dat-mon type="filter"}}
    {{> dat-hang/dung-chung type="benefits"}}
{{/dat-hang/dung-chung}}