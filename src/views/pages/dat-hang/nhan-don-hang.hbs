{{#> dat-hang/dung-chung
    type="page-shell"
    page="management"
}}
    <div class="order-heading-actions">
        {{> dat-hang/dung-chung
            type="page-header"
            title="Nhận đơn hàng"
            description="Theo dõi và xử lý đơn hàng tại nhà ăn của cơ sở."
        }}

        <div class="order-action-row">
            <button
                type="button"
                class="order-button order-button--outline"
                data-orders-refresh
            >
                <i class="fa-solid fa-rotate"></i>
                Làm mới
            </button>

            <button
                type="button"
                class="order-button order-button--primary"
                data-management-export
            >
                <i class="fa-solid fa-download"></i>
                Xuất dữ liệu
            </button>
        </div>
    </div>

    {{#> dat-hang/dung-chung type="management-layout"}}
        <div class="order-stat-grid" data-management-stats></div>

        {{#> dat-hang/dung-chung
            type="card"
            title="Danh sách đơn hàng"
            icon="fa-solid fa-list"
        }}
            <div class="order-search-row">
                {{> forms/search
                    inputId="orderListSearch"
                    placeholder="Tìm mã đơn, người đặt, người nhận..."
                    showClear=true
                    hideDropdown=true
                }}

                <button
                    type="button"
                    class="order-button order-button--outline"
                    data-toggle-filters
                    aria-expanded="false"
                >
                    <i class="fa-solid fa-filter"></i>
                    Bộ lọc
                </button>
            </div>

            {{> dat-hang/quan-ly-don type="filter"}}
            {{> dat-hang/quan-ly-don type="table" management=true}}
        {{/dat-hang/dung-chung}}
    {{/dat-hang/dung-chung}}

    {{> dat-hang/chi-tiet type="dialog"}}
{{/dat-hang/dung-chung}}