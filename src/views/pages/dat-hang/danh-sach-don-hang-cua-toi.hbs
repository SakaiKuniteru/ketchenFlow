<link rel="stylesheet" href="/assets/css/catalog/pagination.css">
{{#> dat-hang/dung-chung
    type="page-shell"
    page="my-orders"
}}
    <div class="order-heading-actions">
        {{> dat-hang/dung-chung
            type="page-header"
            title="Đơn hàng của tôi"
            description="Theo dõi món đã đặt và tiến trình giao nhận."
        }}

        <div class="order-action-row">
            <button
                type="button"
                class="order-button order-button--outline"
                data-orders-refresh
            >
                <i class="fa-solid fa-rotate"></i>
                Làm mới
            </button>

            <a
                class="order-button order-button--primary"
                href="/dat-hang/dat-mon"
            >
                Đặt món mới
            </a>
        </div>
    </div>

    {{#> dat-hang/dung-chung
        type="card"
        title="Danh sách đơn hàng"
        icon="fa-solid fa-receipt"
    }}
        <div class="order-search-row">
            {{> forms/search
                inputId="orderListSearch"
                placeholder="Tìm theo mã đơn hoặc người nhận..."
                showClear=true
                hideDropdown=true
            }}

            <button
                type="button"
                class="order-button order-button--outline"
                data-toggle-filters
                aria-expanded="false"
            >
                <i class="fa-solid fa-filter"></i>
                Bộ lọc
            </button>
        </div>

        {{> dat-hang/quan-ly-don type="filter"}}
        {{> dat-hang/quan-ly-don type="table"}}
    {{/dat-hang/dung-chung}}
{{/dat-hang/dung-chung}}