
<link
    rel="stylesheet"
    href="/assets/css/pages/ve-an/xac-nhan-su-dung-ve.css">


<main
    class="data-list-page"
    data-data-list-page
    data-module="{{listPage.moduleName}}"
    data-list-endpoint="{{listPage.listEndpoint}}">

    {{> common/data-list/header
        listPage=listPage
    }}

    {{> common/data-list/summary
        listPage=listPage
    }}

    {{> common/data-list/data-card
        listPage=listPage
    }}

    {{> common/data-list/filter
        listPage=listPage
    }}

</main>


{{> catalog/no-permission}}


<div
    class="modal"
    id="veBulkCancelModal"
    hidden>

    <div
        class="modal__backdrop"
        data-ticket-cancel-close>
    </div>

    <section
        class="modal__dialog modal__dialog--small"
        role="dialog"
        aria-modal="true"
        aria-labelledby="veBulkCancelTitle">

        <header class="modal__header">

            <h2
                class="modal__title"
                id="veBulkCancelTitle">

                Hủy vé đã chọn

            </h2>

            <button
                type="button"
                class="modal__close"
                data-ticket-cancel-close
                aria-label="Đóng">

                <i class="fa-solid fa-xmark"></i>

            </button>

        </header>

        <div class="modal__body">

            {{> forms/textarea
                id="lyDoHuyVeHangLoat"
                name="lyDoHuyVeHangLoat"
                label="Lý do hủy"
                placeholder="Nhập lý do hủy các vé đã chọn..."
                rows=4
                maxlength=500
                required=true
            }}

        </div>

        <footer class="modal__footer">

            <button
                type="button"
                class="btn btn-secondary"
                data-ticket-cancel-close>

                Đóng

            </button>

            <button
                type="button"
                class="btn btn-danger"
                data-ticket-cancel-submit>

                Hủy vé đã chọn

            </button>

        </footer>

    </section>

</div>


<div
    class="modal"
    id="veDetailModal"
    hidden>

    <div
        class="modal__backdrop"
        data-ticket-detail-close>
    </div>

    <section
        class="modal__dialog"
        role="dialog"
        aria-modal="true"
        aria-labelledby="veDetailTitle">

        <header class="modal__header">

            <h2
                class="modal__title"
                id="veDetailTitle">

                Chi tiết vé ăn

            </h2>

            <button
                type="button"
                class="modal__close"
                data-ticket-detail-close
                aria-label="Đóng">

                <i class="fa-solid fa-xmark"></i>

            </button>

        </header>

        <div class="modal__body">

            <div class="ticket-detail-grid">

                <div>
                    <span>Mã vé</span>
                    <strong data-detail-ma-ve>-</strong>
                </div>

                <div>
                    <span>Mã phiếu</span>
                    <strong data-detail-so-phieu>-</strong>
                </div>

                <div>
                    <span>Người lấy vé</span>
                    <strong data-detail-nguoi-lay-ve>-</strong>
                </div>

                <div>
                    <span>Trạng thái</span>
                    <strong data-detail-trang-thai>-</strong>
                </div>

                <div>
                    <span>Trạng thái thanh toán</span>
                    <strong data-detail-trang-thai-thanh-toan>-</strong>
                </div>

                <div>
                    <span>Thời gian tạo</span>
                    <strong data-detail-thoi-gian-tao>-</strong>
                </div>

                <div>
                    <span>Thời gian thanh toán</span>
                    <strong data-detail-thoi-gian-thanh-toan>-</strong>
                </div>

                <div>
                    <span>Cơ sở</span>
                    <strong data-detail-co-so>-</strong>
                </div>

                <div>
                    <span>Nhà ăn</span>
                    <strong data-detail-nha-an>-</strong>
                </div>

                <div>
                    <span>Ca ăn</span>
                    <strong data-detail-ca-an>-</strong>
                </div>

                <div>
                    <span>Ngày sử dụng</span>
                    <strong data-detail-ngay>-</strong>
                </div>

                <div class="ticket-detail-grid__full">
                    <span>Thực đơn</span>
                    <strong data-detail-thuc-don>-</strong>
                </div>

            </div>

        </div>

        <footer class="modal__footer">

            <button
                type="button"
                class="btn btn-secondary"
                data-ticket-detail-close>

                Đóng

            </button>

        </footer>

    </section>

</div>


<script src="/assets/js/pages/ve-an/permission.js"></script>
<script src="/assets/js/pages/ve-an/xac-nhan-su-dung-ve.js"></script>