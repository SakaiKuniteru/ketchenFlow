<link rel="stylesheet" href="/assets/css/pages/ve-an/lay-ve-an.css">

<main
    class="lva-page"
    data-lay-ve-an-page
    data-page-id="{{pageId}}">

    <header class="lva-page__header">
        <div>
            <h1>Lấy vé ăn</h1>
            <p>Điền thông tin người lấy vé, áp dụng miễn giảm và thanh toán để nhận vé ăn.</p>
        </div>

        <div class="lva-page__actions">

            <button
                type="button"
                class="lva-btn lva-btn--outline"
                data-new-ticket>

                <i class="fa-solid fa-plus"></i>

                <span data-new-ticket-label>
                    Lấy vé mới
                </span>

            </button>

        </div>
    </header>

    <div class="lva-layout">

        <section class="lva-main">

            {{> ve-an/lay-ve-an/phieu-lay-ve}}

            {{> ve-an/lay-ve-an/mien-giam}}

        </section>

        {{> ve-an/lay-ve-an/thanh-toan}}

    </div>

    <div class="lva-modal" data-discount-modal hidden>
        <div class="lva-modal__backdrop" data-discount-close></div>

        <section
            class="lva-modal__dialog"
            role="dialog"
            aria-modal="true"
            aria-labelledby="discountTitle">

            <header class="lva-modal__header">
                <div>
                    <h2 id="discountTitle">Miễn giảm</h2>
                    <p>Chọn miễn giảm khả dụng hoặc tạo miễn giảm thủ công.</p>
                </div>

                <button type="button" class="lva-icon-btn" data-discount-close aria-label="Đóng">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </header>

            <div class="lva-tabs">
                <button type="button" class="is-active" data-discount-tab="available">Khả dụng</button>
                <button type="button" data-discount-tab="manual">Tạo thủ công</button>
            </div>

            <div class="lva-modal__body">

                <div data-discount-panel="available">
                    <div class="lva-discount-search">
                        {{> forms/search
                            inputId="mienGiamSearch"
                            className="search-picker--lay-ve-mien-giam"
                            placeholder="Tìm theo mã, tên voucher hoặc chính sách..."
                            listSearch=true
                            showClear=true
                            hideDropdown=true
                        }}
                    </div>

                    <div class="lva-available-list" data-discount-available>
                        <span class="lva-empty">Không có miễn giảm khả dụng.</span>
                    </div>
                </div>

                <div data-discount-panel="manual" hidden>

                    <div class="lva-form-grid lva-form-grid--modal">

                        {{> forms/input
                            id="maMienGiam"
                            name="maMienGiam"
                            label="Mã miễn giảm"
                            placeholder="Nhập mã"
                            maxlength=50
                        }}

                        {{> forms/input
                            id="tenMienGiam"
                            name="tenMienGiam"
                            label="Tên miễn giảm"
                            placeholder="Nhập tên miễn giảm"
                            maxlength=255
                            required=true
                        }}

                        {{> forms/select
                            id="loaiMienGiam"
                            name="loaiMienGiam"
                            label="Loại miễn giảm"
                            mode="single"
                            multiple=false
                            allowAll=false
                            placeholder="Chọn loại miễn giảm..."
                            options=null
                            required=true
                        }}

                        {{> forms/number
                            id="giaTriMienGiam"
                            name="giaTriMienGiam"
                            label="Giá trị"
                            placeholder="Nhập giá trị"
                            min=0
                            step="0.00001"
                            required=true
                        }}

                        <div class="lva-form-grid__full">
                            {{> forms/textarea
                                id="lyDoMienGiam"
                                name="lyDoMienGiam"
                                label="Lý do miễn giảm"
                                placeholder="Nhập lý do"
                                rows=3
                                maxlength=500
                                required=true
                            }}
                        </div>

                    </div>

                    <div class="lva-modal__footer">
                        <button type="button" class="lva-btn lva-btn--outline" data-discount-close>Hủy</button>
                        <button type="button" class="lva-btn lva-btn--primary" data-discount-create>Thêm miễn giảm</button>
                    </div>

                </div>

            </div>
        </section>
    </div>

    <div
        class="lva-modal"
        data-refund-modal
        hidden>

        <div
            class="lva-modal__backdrop"
            data-refund-close>
        </div>

        <section
            class="lva-modal__dialog lva-modal__dialog--sm"
            role="dialog"
            aria-modal="true"
            aria-labelledby="refundTitle">

            <header class="lva-modal__header">

                <div>
                    <h2 id="refundTitle">
                        Hoàn phiếu / hoàn thanh toán
                    </h2>

                    <p>
                        Nhập thông tin hoàn theo số lượng vé cần hoàn.
                    </p>
                </div>

                <button
                    type="button"
                    class="lva-icon-btn"
                    data-refund-close
                    aria-label="Đóng">

                    <i class="fa-solid fa-xmark"></i>

                </button>

            </header>

            <div class="lva-modal__body">

                <div class="lva-form-grid lva-form-grid--modal">

                    {{> forms/number
                        id="soLuongHoan"
                        name="soLuongHoan"
                        label="Số lượng hoàn"
                        placeholder="Nhập số lượng hoàn"
                        min=1
                        step=1
                        required=true
                    }}

                    {{> forms/select
                        id="phuongThucHoan"
                        name="phuongThucHoan"
                        label="Phương thức hoàn"
                        mode="single"
                        multiple=false
                        allowAll=false
                        placeholder="Chọn phương thức hoàn..."
                        options=null
                        required=true
                    }}

                    <div class="lva-form-grid__full">

                        {{> forms/textarea
                            id="lyDoHoan"
                            name="lyDoHoan"
                            label="Lý do hoàn"
                            placeholder="Nhập lý do hoàn"
                            rows=3
                            maxlength=500
                            required=true
                        }}

                    </div>

                </div>

                <div class="lva-modal__footer">

                    <button
                        type="button"
                        class="lva-btn lva-btn--outline"
                        data-refund-close>

                        Đóng

                    </button>

                    <button
                        type="button"
                        class="lva-btn lva-btn--primary"
                        data-refund-submit>

                        Xác nhận hoàn

                    </button>

                </div>

            </div>

        </section>

    </div>

    <div
        class="lva-modal"
        data-cancel-phieu-modal
        hidden>

        <div
            class="lva-modal__backdrop"
            data-cancel-phieu-close>
        </div>

        <section
            class="lva-modal__dialog lva-modal__dialog--sm"
            role="dialog"
            aria-modal="true"
            aria-labelledby="cancelPhieuTitle">

            <header class="lva-modal__header">

                <div>
                    <h2 id="cancelPhieuTitle">
                        Hủy phiếu lấy vé
                    </h2>

                    <p>
                        Nhập lý do hủy phiếu trước khi xác nhận.
                    </p>
                </div>

                <button
                    type="button"
                    class="lva-icon-btn"
                    data-cancel-phieu-close
                    aria-label="Đóng">

                    <i class="fa-solid fa-xmark"></i>

                </button>

            </header>

            <div class="lva-modal__body">

                {{> forms/textarea
                    id="lyDoHuyPhieu"
                    name="lyDoHuyPhieu"
                    label="Lý do hủy"
                    placeholder="Nhập lý do hủy phiếu..."
                    rows=4
                    maxlength=500
                    required=true
                }}

                <div class="lva-modal__footer">

                    <button
                        type="button"
                        class="lva-btn lva-btn--outline"
                        data-cancel-phieu-close>

                        Đóng

                    </button>

                    <button
                        type="button"
                        class="lva-btn lva-btn--danger"
                        data-cancel-phieu-submit>

                        Tiếp tục

                    </button>

                </div>

            </div>

        </section>

    </div>

</main>

<script src="/assets/js/pages/ve-an/permission.js"></script>
