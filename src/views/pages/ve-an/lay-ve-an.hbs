<link rel="stylesheet" href="/assets/css/pages/ve-an/lay-ve-an.css">

<main class="lva-page" data-lay-ve-an-page>

    <header class="lva-page__header">
        <div>
            <h1>Lấy vé ăn</h1>
            <p>Điền thông tin người lấy vé, áp dụng miễn giảm và thanh toán để nhận vé ăn.</p>
        </div>

        <div class="lva-page__actions">

            <button
                type="button"
                class="lva-btn lva-btn--outline"
                data-new-ticket>

                <i class="fa-solid fa-plus"></i>

                <span data-new-ticket-label>
                    Lấy vé mới
                </span>

            </button>

        </div>
    </header>

    <div class="lva-layout">

        <section class="lva-main">

            <article class="lva-card">

                <div class="lva-card__title">
                    <i class="fa-regular fa-calendar"></i>
                    <span>Thông tin bữa ăn</span>
                </div>

                <div class="lva-form-single">
                    {{> forms/select
                        id="thucDonNgayId"
                        name="thucDonNgayId"
                        label="Bữa ăn / thực đơn"
                        mode="single"
                        multiple=false
                        allowAll=false
                        placeholder="Chọn bữa ăn..."
                        options=null
                        required=true
                    }}
                </div>

                <div class="lva-meal" data-meal-detail hidden>
                    <div class="lva-meal__meta">
                        <div><span>Ngày:</span><strong data-meal-date>-</strong></div>
                        <div><span>Thực đơn:</span><strong data-meal-name>-</strong></div>
                        <div><span>Nhà ăn:</span><strong data-meal-canteen>-</strong></div>
                        <div><span>Ca ăn:</span><strong data-meal-shift>-</strong></div>
                        <div><span>Khung giờ:</span><strong data-meal-time>-</strong></div>
                    </div>

                    <a
                        class="lva-btn lva-btn--outline lva-btn--sm"
                        data-view-menu
                        href="#"
                        target="_blank"
                        rel="noopener">
                        <i class="fa-regular fa-eye"></i>
                        Xem thực đơn
                    </a>
                </div>

            </article>

            <article class="lva-card">

                <div class="lva-card__title">
                    <i class="fa-solid fa-user"></i>
                    <span>Thông tin người lấy vé</span>
                </div>

                <div class="lva-form-grid lva-form-grid--person">

                    <div data-quantity-field>
                        {{> forms/number
                            id="soLuong"
                            name="soLuong"
                            label="Số lượng vé"
                            placeholder="1"
                            min=1
                            step=1
                            required=true
                        }}
                    </div>

                    {{> forms/select
                        id="doiTuongLayVe"
                        name="doiTuongLayVe"
                        label="Đối tượng lấy vé"
                        mode="single"
                        multiple=false
                        allowAll=false
                        placeholder="Chọn đối tượng lấy vé..."
                        options=null
                        required=true
                    }}

                    <div data-employee-select-field hidden>
                        {{> forms/select
                            id="nhanVienId"
                            name="nhanVienId"
                            label="Người lấy vé"
                            mode="single"
                            multiple=false
                            allowAll=false
                            placeholder="Chọn nhân viên..."
                            options=null
                            required=true
                        }}
                    </div>

                </div>

                <div class="lva-employee-info" data-employee-info hidden>
                    <div><span>Mã nhân viên:</span><strong data-employee-code>-</strong></div>
                    <div><span>Họ và tên:</span><strong data-employee-name>-</strong></div>
                    <div><span>Phòng ban:</span><strong data-employee-department>-</strong></div>
                    <div><span>Cơ sở:</span><strong data-employee-site>-</strong></div>
                    <div><span>Số điện thoại:</span><strong data-employee-phone>-</strong></div>

                    <div class="lva-employee-info__note">
                        {{> forms/textarea
                            id="ghiChuNhanVien"
                            name="ghiChuNhanVien"
                            label="Ghi chú"
                            placeholder="Nhập ghi chú (nếu có)..."
                            rows=3
                            maxlength=1000
                        }}
                    </div>
                </div>

                <div class="lva-guest-form" data-guest-form hidden>
                    <div class="lva-form-grid">

                        {{> forms/input
                            id="hoTenNguoiLayVe"
                            name="hoTenNguoiLayVe"
                            label="Họ tên"
                            placeholder="Nhập họ tên"
                            maxlength=150
                            required=true
                        }}

                        {{> forms/input
                            id="soDienThoaiNguoiLayVe"
                            name="soDienThoaiNguoiLayVe"
                            label="Số điện thoại"
                            placeholder="Nhập số điện thoại"
                            maxlength=20
                        }}

                        {{> forms/date
                            id="ngaySinhNguoiLayVe"
                            name="ngaySinhNguoiLayVe"
                            label="Ngày sinh"
                            placeholder="dd/mm/yyyy"
                            defaultTime="00:00:00"
                        }}

                        {{> forms/select
                            id="gioiTinhNguoiLayVe"
                            name="gioiTinhNguoiLayVe"
                            label="Giới tính"
                            mode="single"
                            multiple=false
                            allowAll=false
                            placeholder="Chọn giới tính..."
                            options=null
                        }}

                        {{> forms/input
                            id="donViNguoiLayVe"
                            name="donViNguoiLayVe"
                            label="Đơn vị"
                            placeholder="Nhập đơn vị"
                            maxlength=255
                        }}

                        <div class="lva-checkbox-field">
                            {{> forms/checkbox
                                id="khachLauDai"
                                name="khachLauDai"
                                label="Khách lâu dài"
                                checked=false
                            }}
                        </div>

                        <div class="lva-form-grid__full">
                            {{> forms/input
                                id="diaChiNguoiLayVe"
                                name="diaChiNguoiLayVe"
                                label="Địa chỉ"
                                placeholder="Nhập địa chỉ"
                            }}
                        </div>

                        <div class="lva-form-grid__full">
                            {{> forms/textarea
                                id="ghiChuKhach"
                                name="ghiChuKhach"
                                label="Ghi chú"
                                placeholder="Nhập ghi chú (nếu có)..."
                                rows=3
                                maxlength=1000
                            }}
                        </div>

                    </div>
                </div>

            </article>

            <article class="lva-card">

                <div class="lva-card__title-row">
                    <div class="lva-card__title">
                        <i class="fa-solid fa-tag"></i>
                        <span>Miễn giảm</span>
                    </div>

                    <button
                        type="button"
                        class="lva-btn lva-btn--outline lva-btn--sm"
                        data-discount-open
                        hidden>
                        Tạo miễn giảm
                    </button>
                </div>

                <p class="lva-card__hint">Các miễn giảm đã áp dụng cho phiếu này.</p>

                <div class="lva-discount-list" data-discount-list>
                    <span class="lva-empty">Chưa có miễn giảm.</span>
                </div>

            </article>

            <article class="lva-card lva-card--note">
                <div class="lva-card__title">
                    <i class="fa-solid fa-circle-info"></i>
                    <span>Lưu ý</span>
                </div>

                <ul>
                    <li>Vé chỉ áp dụng cho đúng ngày và ca ăn đã chọn.</li>
                    <li>Có thể thay đổi thông tin trước khi thanh toán.</li>
                    <li>Sau khi có miễn giảm, các trường ảnh hưởng đến giá sẽ được khóa để tránh sai lệch tiền.</li>
                    <li>Thực đơn ngày đã chọn được ghi nhớ trong session trong ngày.</li>
                </ul>
            </article>

        </section>

        <aside class="lva-payment">

            <article class="lva-card lva-card--sticky">

                <div class="lva-card__title">
                    <i class="fa-regular fa-file-lines"></i>
                    <span>Tóm tắt thanh toán</span>
                </div>

                <div class="lva-summary">
                    <div><span>Loại vé:</span><strong data-summary-ticket>-</strong></div>
                    <div><span>Số lượng:</span><strong data-summary-qty>1 vé</strong></div>
                    <div><span>Đơn giá:</span><strong data-summary-price>-</strong></div>
                    <div><span>Tiền gốc:</span><strong data-summary-original>-</strong></div>
                    <div><span>Miễn giảm:</span><strong class="is-discount" data-summary-discount>0 đ</strong></div>
                </div>

                <div class="lva-total">
                    <span>Thành tiền:</span>
                    <strong data-summary-total>-</strong>
                </div>

                <div class="lva-payment-methods" data-payment-section hidden>
                    <h3>Phương thức thanh toán</h3>
                    <div data-payment-method-list></div>
                </div>

                <div class="lva-qr-panel" data-qr-panel hidden>
                    <div class="lva-qr-panel__icon">
                        <i class="fa-solid fa-qrcode"></i>
                    </div>

                    <div>
                        <strong>Giao dịch QR đang chờ thanh toán</strong>
                        <span data-qr-code></span>
                    </div>

                    <button
                        type="button"
                        class="lva-btn lva-btn--danger lva-btn--sm"
                        data-cancel-qr
                        hidden>
                        Hủy QR
                    </button>
                </div>

                <div class="lva-action-stack">
                    <button type="button" class="lva-btn lva-btn--outline" data-print hidden>
                        <i class="fa-solid fa-print"></i>
                        In vé
                    </button>

                    <button type="button" class="lva-btn lva-btn--primary" data-pay hidden>
                        <i class="fa-solid fa-ticket"></i>
                        Thanh toán & lấy vé
                    </button>

                    <button type="button" class="lva-btn lva-btn--success" data-confirm-payment hidden>
                        <i class="fa-solid fa-check"></i>
                        Xác nhận thanh toán
                    </button>

                    <button type="button" class="lva-btn lva-btn--outline" data-refund hidden>
                        <i class="fa-solid fa-rotate-left"></i>
                        Hoàn tiền
                    </button>

                    <button type="button" class="lva-btn lva-btn--danger-soft" data-cancel-phieu hidden>
                        Hủy phiếu
                    </button>
                </div>

                <div class="lva-ticket-note">
                    <i class="fa-solid fa-ticket"></i>
                    <span>Sau khi thanh toán thành công, hệ thống sinh vé ăn theo số lượng đã chọn.</span>
                </div>

            </article>

        </aside>

    </div>

    <div class="lva-modal" data-discount-modal hidden>
        <div class="lva-modal__backdrop" data-discount-close></div>

        <section
            class="lva-modal__dialog"
            role="dialog"
            aria-modal="true"
            aria-labelledby="discountTitle">

            <header class="lva-modal__header">
                <div>
                    <h2 id="discountTitle">Miễn giảm</h2>
                    <p>Chọn miễn giảm khả dụng hoặc tạo miễn giảm thủ công.</p>
                </div>

                <button type="button" class="lva-icon-btn" data-discount-close aria-label="Đóng">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </header>

            <div class="lva-tabs">
                <button type="button" class="is-active" data-discount-tab="available">Khả dụng</button>
                <button type="button" data-discount-tab="manual">Tạo thủ công</button>
            </div>

            <div class="lva-modal__body">

                <div data-discount-panel="available">
                    <div class="lva-discount-search">
                        {{> forms/search
                            inputId="mienGiamSearch"
                            className="search-picker--lay-ve-mien-giam"
                            placeholder="Tìm theo mã, tên voucher hoặc chính sách..."
                            listSearch=true
                            showClear=true
                            hideDropdown=true
                        }}
                    </div>
                    <div class="lva-available-list" data-discount-available>
                        <span class="lva-empty">Không có miễn giảm khả dụng.</span>
                    </div>
                </div>

                <div data-discount-panel="manual" hidden>

                    <div class="lva-form-grid lva-form-grid--modal">

                        {{> forms/input
                            id="maMienGiam"
                            name="maMienGiam"
                            label="Mã miễn giảm"
                            placeholder="Nhập mã"
                            maxlength=50
                        }}

                        {{> forms/input
                            id="tenMienGiam"
                            name="tenMienGiam"
                            label="Tên miễn giảm"
                            placeholder="Nhập tên miễn giảm"
                            maxlength=255
                            required=true
                        }}

                        {{> forms/select
                            id="loaiMienGiam"
                            name="loaiMienGiam"
                            label="Loại miễn giảm"
                            mode="single"
                            multiple=false
                            allowAll=false
                            placeholder="Chọn loại miễn giảm..."
                            options=null
                            required=true
                        }}

                        {{> forms/number
                            id="giaTriMienGiam"
                            name="giaTriMienGiam"
                            label="Giá trị"
                            placeholder="Nhập giá trị"
                            min=0
                            step="0.00001"
                            required=true
                        }}

                        <div class="lva-form-grid__full">
                            {{> forms/textarea
                                id="lyDoMienGiam"
                                name="lyDoMienGiam"
                                label="Lý do miễn giảm"
                                placeholder="Nhập lý do"
                                rows=3
                                maxlength=500
                                required=true
                            }}
                        </div>

                    </div>

                    <div class="lva-modal__footer">
                        <button type="button" class="lva-btn lva-btn--outline" data-discount-close>Hủy</button>
                        <button type="button" class="lva-btn lva-btn--primary" data-discount-create>Thêm miễn giảm</button>
                    </div>

                </div>

            </div>

        </section>
    </div>

</main>

<script src="/assets/js/pages/ve-an/permission.js"></script>
<script src="/assets/js/pages/ve-an/lay-ve-an.js"></script>