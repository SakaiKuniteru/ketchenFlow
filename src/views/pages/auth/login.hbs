<section id='loginPage' class='login-page'>

    <div class='login-page__background'>

        <div class='login-page__decoration login-page__decoration--one' aria-hidden='true'>
        </div>

        <div class='login-page__decoration login-page__decoration--two' aria-hidden='true'>
        </div>

        <div class='login-page__decoration login-page__decoration--three' aria-hidden='true'>
        </div>

    </div>

    <div class='login-page__container'>

        <section class='login-brand' aria-label='Giới thiệu MCS KitchenFlow'>

            <div class='login-brand__content'>

                <a href='/auth/login' class='login-brand__logo-link' aria-label='MCS KitchenFlow'>

                    <img
                        src='/assets/images/logo/logo.png'
                        alt='Logo MCS KitchenFlow'
                        class='login-brand__logo'
                        data-system-logo
                    />

                </a>

                <div class='login-brand__heading'>

                    <span class='login-brand__company'>
                        MCS SOFTWARE
                    </span>

                    <h1 class='login-brand__name' data-system-name>
                        MCS KITCHENFLOW
                    </h1>

                    <p class='login-brand__description'>
                        Giải pháp quản lý nhà ăn, suất ăn và kho thực phẩm tập trung, chính xác và hiệu quả.
                    </p>

                </div>

                <ul class='login-brand__features'>

                    <li class='login-brand__feature'>

                        <span class='login-brand__feature-icon' aria-hidden='true'>
                            ✓
                        </span>

                        <span>
                            Quản lý nhà ăn và suất ăn tập trung
                        </span>

                    </li>

                    <li class='login-brand__feature'>

                        <span class='login-brand__feature-icon' aria-hidden='true'>
                            ✓
                        </span>

                        <span>
                            Theo dõi thực phẩm và tồn kho chính xác
                        </span>

                    </li>

                    <li class='login-brand__feature'>

                        <span class='login-brand__feature-icon' aria-hidden='true'>
                            ✓
                        </span>

                        <span>
                            Phân quyền và bảo mật theo vai trò
                        </span>

                    </li>

                </ul>

            </div>

            <div class='login-brand__footer'>

                <span>
                    ©
                    {{currentYear}}
                    MCS KITCHENFLOW
                </span>

                <span>
                    Bản quyền thuộc về MCS Software.
                </span>

            </div>

        </section>

        <main class='login-form-section'>

            <div class='login-card'>

                <div class='login-card__mobile-brand'>

                    <img
                        src='/assets/images/logo/logo.png'
                        alt='Logo MCS KitchenFlow'
                        class='login-card__mobile-logo'
                        data-system-logo
                    />

                    <span data-system-name>
                        MCS KITCHENFLOW
                    </span>

                </div>

                <header class='login-card__header'>

                    <p class='login-card__eyebrow'>
                        Chào mừng trở lại
                    </p>

                    <h2 class='login-card__title'>
                        Đăng nhập hệ thống
                    </h2>

                    <p class='login-card__description'>
                        Nhập thông tin tài khoản để tiếp tục sử dụng
                        <span data-system-name>
                            MCS KITCHENFLOW
                        </span>.
                    </p>

                </header>

                <div id='loginMessage' class='login-card__message' role='alert' aria-live='polite' hidden>

                    <span class='login-card__message-icon' aria-hidden='true'>
                        !
                    </span>

                    <span class='login-card__message-text' data-login-message>
                    </span>

                </div>

                <form id='loginForm' class='login-form' autocomplete='on' novalidate>

                    <div class='form-field' data-form-field='taiKhoan'>

                        <label for='taiKhoan' class='form-field__label'>

                            <span>
                                Tên đăng nhập
                            </span>

                            <span class='form-field__required' aria-hidden='true'>
                                *
                            </span>

                        </label>

                        <div class='form-field__control'>

                            <span class='login-form__field-icon' aria-hidden='true'>
                                👤
                            </span>

                            <input
                                type='text'
                                id='taiKhoan'
                                name='taiKhoan'
                                class='form-input login-form__input'
                                placeholder='Nhập tên đăng nhập'
                                maxlength='100'
                                autocomplete='username'
                                autocapitalize='none'
                                spellcheck='false'
                                aria-describedby='taiKhoanError'
                                required
                            />

                        </div>

                        <small id='taiKhoanError' class='form-field__error' data-field-error='taiKhoan' hidden>
                        </small>

                    </div>

                    <div class='form-field' data-form-field='matKhau'>

                        <label for='matKhau' class='form-field__label'>

                            <span>
                                Mật khẩu
                            </span>

                            <span class='form-field__required' aria-hidden='true'>
                                *
                            </span>

                        </label>

                        <div class='form-field__control'>

                            <span class='login-form__field-icon' aria-hidden='true'>
                                🔒
                            </span>

                            <input
                                type='password'
                                id='matKhau'
                                name='matKhau'
                                class='form-input login-form__input login-form__input--password'
                                placeholder='Nhập mật khẩu'
                                autocomplete='current-password'
                                aria-describedby='matKhauError'
                                required
                            />

                            <button
                                type='button'
                                id='togglePasswordButton'
                                class='login-form__password-toggle'
                                aria-label='Hiện mật khẩu'
                                aria-pressed='false'
                                data-password-toggle
                            >

                                <span data-password-show-icon aria-hidden='true'>
                                    👁
                                </span>

                                <span data-password-hide-icon aria-hidden='true' hidden>
                                    ◉
                                </span>

                            </button>

                        </div>

                        <small id='matKhauError' class='form-field__error' data-field-error='matKhau' hidden>
                        </small>

                    </div>

                    <div class='login-form__options'>

                        <label for='rememberAccount' class='login-form__remember'>

                            <input
                                type='checkbox'
                                id='rememberAccount'
                                name='rememberAccount'
                                class='login-form__remember-input'
                            />

                            <span class='login-form__remember-box' aria-hidden='true'>
                            </span>

                            <span>
                                Ghi nhớ tên đăng nhập
                            </span>

                        </label>

                    </div>

                    <button type='submit' id='loginSubmitButton' class='login-form__submit' data-login-submit>

                        <span class='login-form__submit-spinner' data-login-spinner aria-hidden='true' hidden>
                        </span>

                        <span data-login-submit-label>
                            Đăng nhập
                        </span>

                    </button>

                </form>

                <footer class='login-card__footer'>

                    <p>
                        Gặp vấn đề khi đăng nhập?
                    </p>

                    <p>
                        Vui lòng liên hệ quản trị viên hệ thống.
                    </p>

                    {{#if appVersion}}

                        <small class='login-card__version'>
                            Phiên bản
                            {{appVersion}}
                        </small>

                    {{/if}}

                </footer>

            </div>

        </main>

    </div>

</section>