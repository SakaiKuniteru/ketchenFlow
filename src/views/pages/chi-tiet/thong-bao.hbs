<link rel="stylesheet" href="/assets/css/pages/chi-tiet/thong-bao.css">

<section class="notification-page" data-notification-page>

    <div class="notification-page__card" data-notification-page-content>

        <header class="notification-page__header">

            <h1>
                Thông báo
            </h1>

            <button type="button" class="notification-page__mark-all" data-notification-page-mark-all hidden>

                <i class="fa-regular fa-circle-check"></i>

                <span>
                    Đánh dấu tất cả đã đọc
                </span>

            </button>

        </header>

        <div class="notification-page__tabs">

            <button type="button" class="notification-page__tab is-active" data-notification-page-filter="all">

                Tất cả

                <span>
                    (
                    <span data-notification-page-total>
                        0
                    </span>
                    )
                </span>

            </button>

            <button type="button" class="notification-page__tab" data-notification-page-filter="unread">

                Chưa đọc

                <span>
                    (
                    <span data-notification-page-unread>
                        0
                    </span>
                    )
                </span>

            </button>

        </div>

        <div class="notification-page__loading" data-notification-page-loading>

            <span class="notification-page__spinner">
            </span>

            <span>
                Đang tải thông báo...
            </span>

        </div>

        <div class="notification-page__list" data-notification-page-list>
        </div>

        <div class="notification-page__empty" data-notification-page-empty hidden>

            <i class="fa-regular fa-bell-slash"></i>

            <strong>
                Chưa có thông báo
            </strong>

            <span>
                Không có thông báo phù hợp với bộ lọc hiện tại.
            </span>

        </div>

    </div>

    {{> catalog/no-permission}}

</section>

<script src="/assets/js/pages/chi-tiet/thong-bao.js">
</script>