<section class="td-card td-general" data-general-section>

    <header class="td-card__header">

        <div>

            <h2>
                Thông tin chung
            </h2>

            <p>
                Thiết lập thông tin và phạm vi áp dụng của thực đơn.
            </p>

        </div>

    </header>


    <div class="td-general__grid" data-general-edit-fields>

        {{> forms/input
            id="maThucDon"
            name="maThucDon"
            label="Mã thực đơn"
            placeholder="Nhập mã thực đơn"
            required=true
        }}


        {{> forms/input
            id="tenThucDon"
            name="tenThucDon"
            label="Tên thực đơn"
            placeholder="Nhập tên thực đơn"
            required=true
        }}


        {{> forms/select
            id="loaiThucDon"
            name="loaiThucDon"
            label="Loại thực đơn"
            mode="single"
            placeholder="Chọn loại thực đơn"
            required=true
        }}


        {{> forms/select
            id="coSoId"
            name="coSoId"
            label="Cơ sở"
            mode="single"
            placeholder="Chọn cơ sở"
            options=null
            required=true
        }}


        {{> forms/select
            id="nhaAnId"
            name="nhaAnId"
            label="Nhà ăn"
            mode="single"
            placeholder="Chọn nhà ăn"
            options=null
            required=true
        }}


        {{> forms/select
            id="caAnId"
            name="caAnId"
            label="Ca ăn"
            mode="single"
            placeholder="Chọn ca ăn"
            options=null
            required=true
        }}

        <input type="hidden" name="tuNgay" data-menu-canonical-from>

        <input type="hidden" name="denNgay" data-menu-canonical-to>

        <div class="td-general__time-field" data-menu-time-day hidden>

            {{> forms/date
                id="ngayApDung"
                name="ngayApDung"
                label="Ngày áp dụng"
                placeholder="dd/mm/yyyy"
                defaultTime="00:00:00"
                required=true
            }}

        </div>

        <div class="td-general__time-field" data-menu-time-week hidden>

            {{> forms/select
                id="tuanApDung"
                name="tuanApDung"
                label="Tuần áp dụng"
                mode="single"
                placeholder="Chọn tuần áp dụng"
                options=null
                required=true
            }}

        </div>

        <div class="td-general__time-month" data-menu-time-month hidden>

            {{> forms/select
                id="namApDung"
                name="namApDung"
                label="Năm"
                mode="single"
                placeholder="Chọn năm"
                options=null
                required=true
            }}

            {{> forms/select
                id="thangApDung"
                name="thangApDung"
                label="Tháng"
                mode="single"
                placeholder="Chọn năm trước"
                options=null
                required=true
                disabled=true
            }}

        </div>

        <div class="td-general__time-field" data-menu-time-range-from hidden>

            {{> forms/date
                id="tuNgayKhoang"
                name="tuNgayKhoang"
                label="Từ ngày"
                placeholder="dd/mm/yyyy"
                defaultTime="00:00:00"
                required=true
            }}

        </div>

        <div class="td-general__time-field" data-menu-time-range-to hidden>

            {{> forms/date
                id="denNgayKhoang"
                name="denNgayKhoang"
                label="Đến ngày"
                placeholder="dd/mm/yyyy"
                defaultTime="23:59:59"
                required=true
            }}

        </div>

        <div class="td-general__description">

            {{> forms/textarea
                id="moTa"
                name="moTa"
                label="Mô tả"
                placeholder="Nhập mô tả thực đơn"
                rows=3
            }}

        </div>


        <div class="form-field td-general__status-field">

            <label class="form-field__label">
                Trạng thái
            </label>

            <span class="td-status is-new" data-editor-status>

                -

            </span>

        </div>

    </div>


    <div class="td-general__detail" data-general-detail-fields hidden>

        <div>

            <span>
                Mã thực đơn
            </span>

            <strong data-detail-ma>
                -
            </strong>

        </div>


        <div>

            <span>
                Tên thực đơn
            </span>

            <strong data-detail-ten>
                -
            </strong>

        </div>


        <div>

            <span>
                Loại thực đơn
            </span>

            <strong data-detail-loai>
                -
            </strong>

        </div>


        <div>

            <span>
                Cơ sở
            </span>

            <strong data-detail-co-so>
                -
            </strong>

        </div>


        <div>

            <span>
                Nhà ăn
            </span>

            <strong data-detail-nha-an>
                -
            </strong>

        </div>


        <div>

            <span>
                Ca ăn
            </span>

            <strong data-detail-ca-an>
                -
            </strong>

        </div>


        <div>

            <span>
                Thời gian áp dụng
            </span>

            <strong data-detail-thoi-gian>
                -
            </strong>

        </div>


        <div>

            <span>
                Trạng thái
            </span>

            <strong>

                <span class="td-status" data-detail-trang-thai>

                    -

                </span>

            </strong>

        </div>


        <div class="is-full">

            <span>
                Mô tả
            </span>

            <strong data-detail-mo-ta>
                -
            </strong>

        </div>

    </div>

</section>