<div class="td-modal" data-modal-day hidden>

    <div class="td-modal__backdrop" data-modal-close>
    </div>


    <section class="td-modal__dialog is-day" role="dialog" aria-modal="true">

        <header class="td-modal__header">

            <div>

                <i class="fa-regular fa-calendar"></i>

                <strong>
                    Chọn ngày áp dụng
                </strong>

            </div>


            <button type="button" class="td-icon-btn" data-modal-close>

                <i class="fa-solid fa-xmark"></i>

            </button>

        </header>


        <div class="td-modal__body">

            <div class="form-field">

                <label class="form-field__label">
                    Danh sách ngày
                </label>

                <div class="td-checkbox-search" data-checkbox-search-target="day">

                    {{> forms/search
                        inputId="tdDaySearch"
                        className="search-picker--thuc-don-modal"
                        placeholder="Tìm theo ngày hoặc thứ..."
                        listSearch=true
                        showClear=true
                        hideDropdown=true
                    }}

                </div>

                <div class="td-checkbox-list" data-checkbox-list-type="day" data-day-checkbox-list>
                </div>

            </div>

        </div>


        <footer class="td-modal__footer">

            <button type="button" class="td-btn" data-modal-close>

                Hủy

            </button>


            <button type="button" class="td-btn td-btn--primary" data-save-day-modal>

                Áp dụng

            </button>

        </footer>

    </section>

</div>