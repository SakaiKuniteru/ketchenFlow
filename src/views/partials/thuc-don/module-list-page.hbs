<section class="module-list-page" data-module-list-page="{{moduleName}}">

    <header class="module-list-page__header">

        <div>

            <h1 class="module-list-page__title">
                {{title}}
            </h1>

            {{#if description}}

                <p class="module-list-page__description">
                    {{description}}
                </p>

            {{/if}}

        </div>

        {{#if createUrl}}

            <a href="{{createUrl}}" class="module-list-page__create" data-list-create>

                <i class="fa-solid fa-plus"></i>

                <span>
                    Thêm mới
                </span>

            </a>

        {{/if}}

    </header>


    <div class="module-list-page__toolbar">

        <button type="button" class="module-list-page__filter-button" data-list-filter-toggle>

            <i class="fa-solid fa-filter"></i>

            <span>
                Bộ lọc
            </span>

        </button>

        <div class="module-list-page__search">
            {{> forms/search
                inputId=searchInputId
                className="search-picker--module-list"
                placeholder=searchPlaceholder
                listSearch=true
                showClear=true
                hideDropdown=true
            }}
        </div>

    </div>


    <div class="module-list-page__filters" data-list-filter-panel hidden>

        {{> (lookup . "filterPartial")}}

    </div>


    <div class="module-list-page__content">

        <table class="module-list-table">

            <thead>

                <tr>

                    {{#each columns}}

                        <th>
                            {{label}}
                        </th>

                    {{/each}}

                    <th class="module-list-table__actions">
                        Thao tác
                    </th>

                </tr>

            </thead>

            <tbody data-list-body>
            </tbody>

        </table>

        <div class="module-list-page__empty" data-list-empty hidden>

            Không có dữ liệu.

        </div>

    </div>

    {{> catalog/pagination
        paginationId=paginationId
    }}

    {{#if showNoPermission}}
        {{> catalog/no-permission}}
    {{/if}}

</section>