<section class="td-card td-content" data-content-section>

    <header class="td-card__header td-content__header">

        <div>
            <h2>
                Nội dung thực đơn
            </h2>
        </div>


        <div class="td-content__header-actions">
            <div class="td-content-search" data-day-search>
                {{> forms/search
                    inputId="thucDonDaySearch"
                    className="search-picker--thuc-don-content"
                    placeholder="Tìm ngày..."
                    listSearch=true
                    showClear=true
                    hideDropdown=true
                }}
            </div>

            <div class="td-view-switcher" data-content-view-switcher>

                <button type="button" class="td-view-switcher__button is-active" data-content-view="detail"
                    title="Xem chi tiết">

                    <i class="fa-solid fa-layer-group"></i>

                    <span>
                        Chi tiết
                    </span>

                </button>

                <button type="button" class="td-view-switcher__button" data-content-view="group"
                    title="Xem theo nhóm món">

                    <i class="fa-solid fa-list"></i>

                    <span>
                        Nhóm món
                    </span>

                </button>

                <button type="button" class="td-view-switcher__button" data-content-view="food" title="Xem theo món ăn">

                    <i class="fa-solid fa-bowl-food"></i>

                    <span>
                        Món ăn
                    </span>

                </button>

            </div>

            <button type="button" class="td-btn td-btn--outline" data-add-day data-editor-only>

                <i class="fa-solid fa-plus"></i>

                <span>
                    Thêm ngày
                </span>

            </button>

        </div>

    </header>

    <div class="td-days" data-days-list>
    </div>

    <div class="td-day-search-empty" data-day-search-empty hidden>

        <i class="fa-solid fa-magnifying-glass"></i>

        <strong>
            Không tìm thấy ngày
        </strong>

        <span>
            Không có ngày nào phù hợp với từ khóa tìm kiếm.
        </span>

    </div>

    <div class="td-content__bottom" data-editor-only>

        <button type="button" class="td-btn td-btn--outline" data-add-day>

            <i class="fa-solid fa-plus"></i>

            <span>
                Thêm ngày
            </span>

        </button>

    </div>

</section>

<template id="td-template-day">

    <article class="td-day" data-day-item>

        <header class="td-day__header">

            <button type="button" class="td-day__toggle" data-toggle-day>

                <span class="td-day__icon">

                    <i class="fa-regular fa-calendar"></i>

                </span>


                <span class="td-day__index" data-day-index>

                    01

                </span>


                <span class="td-day__title">

                    <strong data-day-weekday>
                        -
                    </strong>

                    <span>
                        •
                    </span>

                    <strong data-day-date>
                        -
                    </strong>

                </span>


                <span class="td-day__summary">

                    <span data-day-group-count>
                        0 nhóm
                    </span data-day-group-separator>

                    <span>
                        •
                    </span>

                    <span data-day-food-count>
                        0 món
                    </span>

                </span>


                <i class="fa-solid fa-chevron-down td-chevron"></i>

            </button>


            <button type="button" class="td-icon-btn is-danger" data-delete-day data-editor-only title="Xóa ngày">

                <i class="fa-regular fa-trash-can"></i>

            </button>

        </header>


        <div class="td-day__body" data-day-body hidden>

            <div class="td-section-row">

                <strong data-day-content-title>
                    Danh sách nhóm món
                </strong>


                <button type="button" class="td-btn td-btn--small td-btn--outline" data-add-group data-day-add-group
                    data-editor-only>

                    <i class="fa-solid fa-plus"></i>

                    <span>
                        Thêm nhóm
                    </span>

                </button>

            </div>


            <div class="td-groups" data-groups-list>
            </div>

        </div>

    </article>

</template>

<template id="td-template-group">

    <article class="td-group" data-group-item>

        <header class="td-group__header">

            <button type="button" class="td-group__toggle" data-toggle-group>

                <span class="td-group__icon">

                    <i class="fa-solid fa-leaf"></i>

                </span>


                <strong data-group-name>
                    -
                </strong>


                <span class="td-group__count" data-group-food-count>

                    0 món

                </span>


                <i class="fa-solid fa-chevron-down td-chevron"></i>

            </button>


            <button type="button" class="td-icon-btn is-danger" data-delete-group data-editor-only title="Xóa nhóm">

                <i class="fa-regular fa-trash-can"></i>

            </button>

        </header>


        <div class="td-group__body" data-group-body hidden>

            <div class="td-section-row">

                <strong>
                    Danh sách món
                </strong>


                <button type="button" class="td-btn td-btn--small td-btn--outline" data-add-food data-editor-only>

                    <i class="fa-solid fa-plus"></i>

                    <span>
                        Thêm món
                    </span>

                </button>

            </div>


            <div class="td-foods" data-food-list>
            </div>

        </div>

    </article>

</template>

<template id="td-template-food">

    <article class="td-food" data-food-item>

        <div class="td-food__identity">

            <img src="/uploads/danh-muc/mon-an/mon-an.png" alt="Ảnh món ăn" data-food-image>


            <div>

                <strong data-food-name>
                    -
                </strong>

                <span data-food-code>
                    -
                </span>

            </div>

        </div>


        <div class="td-food__field">

            <span>
                Định lượng
            </span>

            <strong data-food-quantity>
                -
            </strong>

        </div>


        <div class="td-food__field">

            <span>
                Đơn vị
            </span>

            <strong data-food-unit>
                -
            </strong>

        </div>


        <div class="td-food__field">

            <span>
                Khẩu phần
            </span>

            <strong data-food-portion>
                -
            </strong>

        </div>

        <button type="button" class="td-icon-btn is-danger" data-delete-food data-editor-only title="Xóa món">

            <i class="fa-regular fa-trash-can"></i>

        </button>

    </article>

</template>

<template id="td-template-group-overview">

    <article class="td-group td-group--overview" data-group-overview-item>

        <div class="td-group__header">

            <div class="td-group__toggle">

                <span class="td-group__icon">
                    <i class="fa-solid fa-leaf"></i>
                </span>

                <div class="td-group-overview__identity">

                    <strong data-group-overview-name>
                        -
                    </strong>

                    <span data-group-overview-code>
                        -
                    </span>

                </div>


                <span class="td-group__count" data-group-overview-food-count>

                    0 món

                </span>

            </div>

        </div>

    </article>

</template>

<template id="td-template-food-overview">

    <article class="td-food td-food--overview" data-food-overview-item>

        <div class="td-food__identity">

            <img src="/uploads/danh-muc/mon-an/mon-an.png" alt="Ảnh món ăn" data-food-overview-image>


            <div>

                <strong data-food-overview-name>
                    -
                </strong>

                <span data-food-overview-code>
                    -
                </span>

            </div>

        </div>


        <div class="td-food__field" data-food-overview-group-field>

            <span>
                Nhóm món
            </span>

            <strong data-food-overview-group>
                -
            </strong>

        </div>


        <div class="td-food__field">

            <span>
                Định lượng
            </span>

            <strong data-food-overview-quantity>
                -
            </strong>

        </div>


        <div class="td-food__field">

            <span>
                Đơn vị
            </span>

            <strong data-food-overview-unit>
                -
            </strong>

        </div>


        <div class="td-food__field">

            <span>
                Khẩu phần
            </span>

            <strong data-food-overview-portion>
                -
            </strong>

        </div>

    </article>

</template>

<div class="td-empty" data-empty-day hidden>

    <i class="fa-regular fa-calendar-plus"></i>

    <strong>
        Chưa có ngày áp dụng
    </strong>

    <span>
        Thêm ngày để bắt đầu xây dựng nội dung thực đơn.
    </span>

</div>