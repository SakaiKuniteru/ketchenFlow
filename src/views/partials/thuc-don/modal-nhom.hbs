<div class="td-modal" data-modal-group hidden>

    <div class="td-modal__backdrop" data-modal-close>
    </div>


    <section class="td-modal__dialog is-group" role="dialog" aria-modal="true">

        <header class="td-modal__header">

            <div>

                <i class="fa-solid fa-leaf"></i>

                <strong>
                    Chọn nhóm món
                </strong>

            </div>


            <button type="button" class="td-icon-btn" data-modal-close>

                <i class="fa-solid fa-xmark"></i>

            </button>

        </header>


        <div class="td-modal__body">

            <div class="form-field">

                <label class="form-field__label">

                    Nhóm món

                    <span class="form-field__required">
                        *
                    </span>

                </label>

                <div class="td-checkbox-search" data-checkbox-search-target="group">

                    {{> forms/search
                        inputId="tdGroupSearch"
                        className="search-picker--thuc-don-modal"
                        placeholder="Tìm mã hoặc tên nhóm món..."
                        listSearch=true
                        showClear=true
                        hideDropdown=true
                    }}

                </div>

                <div class="td-checkbox-list" data-checkbox-list-type="group" data-group-checkbox-list>

                    <div class="td-checkbox-list__empty">
                        Không còn nhóm món để chọn.
                    </div>

                </div>

            </div>

        </div>


        <footer class="td-modal__footer">

            <button type="button" class="td-btn" data-modal-close>

                Hủy

            </button>


            <button type="button" class="td-btn td-btn--primary" data-save-group-modal>

                Áp dụng

            </button>

        </footer>

    </section>

</div>