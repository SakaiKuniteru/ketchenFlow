<div class='empty-state' role='status'>

    <div class='empty-state__icon' aria-hidden='true'>

        {{#if emptyIcon}}

            <img src='{{emptyIcon}}' alt='' />

        {{else}}

            <span>
                📭
            </span>

        {{/if}}

    </div>

    <h3 class='empty-state__title'>

        {{#if emptyTitle}}

            {{emptyTitle}}

        {{else}}

            Không có dữ liệu

        {{/if}}

    </h3>

    <p class='empty-state__description'>

        {{#if emptyDescription}}

            {{emptyDescription}}

        {{else}}

            Hiện chưa có dữ liệu để hiển thị.

        {{/if}}

    </p>

    {{#if emptyActionLabel}}

        <button type='button' class='empty-state__action' id='{{emptyActionId}}'>

            {{emptyActionLabel}}

        </button>

    {{/if}}

</div>