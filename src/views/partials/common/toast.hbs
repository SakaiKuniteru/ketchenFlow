<div id='toastContainer' class='toast-container' aria-live='polite' aria-atomic='true'>

    <template id='toastTemplate'>

        <article class='toast' role='status'>

            <div class='toast__icon'>

                <span data-toast-icon aria-hidden='true'>
                </span>

            </div>

            <div class='toast__content'>

                <strong class='toast__title' data-toast-title>
                </strong>

                <p class='toast__message' data-toast-message>
                </p>

            </div>

            <button type='button' class='toast__close' data-toast-close aria-label='Đóng thông báo'>
                ×
            </button>

        </article>

    </template>

</div>