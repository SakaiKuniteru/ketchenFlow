<header id="appHeader" class="app-header">

    <div class="app-header__left">

        <button type="button" class="app-header__menu-button" data-sidebar-main-toggle
            aria-label="Mở hoặc thu gọn thanh điều hướng" aria-expanded="false">

            ☰

        </button>

        <div class="app-header__brand">

            <img class="app-header__brand-logo" data-header-system-logo src="/assets/images/logo/logo.png"
                alt="Logo hệ thống">

            <div class="app-header__brand-information">

                <span class="app-header__brand-name" data-header-system-name>

                    MCS KITCHENFLOW

                </span>

                {{#if pageSubtitle}}

                    <span class="app-header__brand-subtitle">
                        {{pageSubtitle}}
                    </span>

                {{/if}}

            </div>

        </div>

    </div>

    <div class="app-header__center">

        {{> forms/search
            searchPickerId="headerFeatureSearch"
            className="search-picker--header"
            placeholder="Nhập để tìm kiếm"
            showShortcut=true
        }}

    </div>

    <div class="app-header__right">

        <div class="app-header__notification" data-header-notification>

            <button type="button" class="app-header__action app-header__notification-button"
                data-header-notification-button aria-label="Thông báo" aria-expanded="false">

                <i class="fa-regular fa-bell" aria-hidden="true">
                </i>

                <span class="app-header__notification-count" data-header-notification-count hidden>
                    0
                </span>

            </button>

            <div class="app-header__notification-menu" data-header-notification-menu hidden>

                <div class="app-header__notification-header">

                    <strong class="app-header__notification-title">
                        Thông báo
                    </strong>

                    <button type="button" class="app-header__notification-mark-all" data-header-notification-mark-all
                        hidden>

                        <i class="fa-regular fa-circle-check"></i>

                        <span>
                            Đánh dấu tất cả đã đọc
                        </span>

                    </button>

                </div>

                <div class="app-header__notification-tabs">

                    <button type="button" class="app-header__notification-tab is-active"
                        data-header-notification-filter="all">

                        Tất cả

                        <span>
                            (
                            <span data-header-notification-total>
                                0
                            </span>
                            )
                        </span>

                    </button>

                    <button type="button" class="app-header__notification-tab" data-header-notification-filter="unread">

                        Chưa đọc

                        <span>
                            (
                            <span data-header-notification-unread-total>
                                0
                            </span>
                            )
                        </span>

                    </button>

                </div>

                <div class="app-header__notification-content">

                    <div class="app-header__notification-loading" data-header-notification-loading hidden>

                        <span class="app-header__notification-spinner">
                        </span>

                        <span>
                            Đang tải thông báo...
                        </span>

                    </div>

                    <div class="app-header__notification-list" data-header-notification-list>
                    </div>

                    <div class="app-header__notification-empty" data-header-notification-empty hidden>

                        <i class="fa-regular fa-bell-slash"></i>

                        <strong>
                            Chưa có thông báo
                        </strong>

                        <span>
                            Các thông báo mới sẽ xuất hiện tại đây.
                        </span>

                    </div>

                </div>

                <a href="/thong-bao" class="app-header__notification-footer" data-header-notification-view-all>

                    Xem tất cả thông báo

                </a>

            </div>

        </div>

        <div class="app-header__user">

            <button type="button" class="app-header__user-button" data-header-user-button aria-expanded="false"
                aria-controls="headerUserMenu">

                <span class="app-header__avatar" data-header-user-avatar>

                    {{#if currentUser.anhDaiDien}}

                        <img src="{{currentUser.anhDaiDien}}" alt="{{currentUser.hoTen}}">

                    {{else}}

                        <span aria-hidden="true">
                            👤
                        </span>

                    {{/if}}

                </span>

                <span class="app-header__user-information">

                    <strong class="app-header__user-name" data-header-user-name>
                        {{#if currentUser.hoTen}}
                            {{currentUser.hoTen}}
                        {{else}}
                            Người dùng
                        {{/if}}
                    </strong>

                    <small class="app-header__username" data-header-account-name>

                        {{#if currentUser.taiKhoan}}

                            {{currentUser.taiKhoan}}

                        {{else if currentUser.tenDangNhap}}

                            {{currentUser.tenDangNhap}}

                        {{else}}

                            Chưa có tài khoản

                        {{/if}}

                    </small>

                </span>

                <span class="app-header__user-arrow" data-header-user-arrow aria-hidden="true">

                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                        stroke-linejoin="round">

                        <path d="m6 9 6 6 6-6"></path>

                    </svg>

                </span>

            </button>


            <div id="headerUserMenu" class="app-header__user-menu" data-header-user-menu hidden>

                <button type="button" class="app-header__user-menu-header app-header__user-menu-header--button"
                    data-header-profile-open>

                    <span class="app-header__user-menu-avatar" data-header-user-avatar>

                        <span aria-hidden="true">
                            👤
                        </span>

                    </span>

                    <span class="app-header__user-menu-information">

                        <strong data-header-user-name>
                            Người dùng
                        </strong>

                        <small data-header-account-name>
                            Chưa có thông tin tài khoản
                        </small>

                    </span>

                    <span class="app-header__profile-arrow" aria-hidden="true">

                        ›

                    </span>

                </button>

                <div class="app-header__user-menu-divider">
                </div>


                <button type="button" class="app-header__user-menu-item" data-header-change-password>

                    <span class="app-header__user-menu-icon" aria-hidden="true">

                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                            stroke-linecap="round" stroke-linejoin="round">

                            <rect x="5" y="10" width="14" height="10" rx="2">
                            </rect>

                            <path d="M8 10V7a4 4 0 0 1 8 0v3">
                            </path>

                        </svg>

                    </span>

                    <span>
                        Đổi mật khẩu
                    </span>

                </button>


                <button type="button" class="
                        app-header__user-menu-item
                        app-header__user-menu-item--danger
                    " data-header-logout>

                    <span class="app-header__user-menu-icon" aria-hidden="true">

                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                            stroke-linecap="round" stroke-linejoin="round">

                            <path d="M9 18H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4">
                            </path>

                            <path d="m16 17 5-5-5-5">
                            </path>

                            <path d="M21 12H9">
                            </path>

                        </svg>

                    </span>

                    <span>
                        Đăng xuất
                    </span>

                </button>

            </div>

        </div>

    </div>

</header>