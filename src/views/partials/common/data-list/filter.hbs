{{#if listPage.filters.length}}

    <div class="data-list-filter" data-list-filter-panel hidden>

        <div class="data-list-filter__body">

            {{#each listPage.filters}}

                {{#if isDateRange}}

                    <div class="data-list-filter__range">

                        <div class="data-list-filter__range-title">
                            {{label}}
                        </div>

                        <div class="data-list-filter__range-grid">

                            <div data-list-filter-field data-filter-name="{{from.name}}" data-filter-type="date">

                                {{> forms/date
                                    id=from.id
                                    name=from.name
                                    label=from.label
                                    placeholder=from.placeholder
                                    showTime=from.showTime
                                    defaultToday=from.defaultToday
                                    defaultTime=from.defaultTime
                                }}

                            </div>

                            <div data-list-filter-field data-filter-name="{{to.name}}" data-filter-type="date">

                                {{> forms/date
                                    id=to.id
                                    name=to.name
                                    label=to.label
                                    placeholder=to.placeholder
                                    showTime=to.showTime
                                    defaultToday=to.defaultToday
                                    defaultTime=to.defaultTime
                                }}

                            </div>

                        </div>

                    </div>

                {{/if}}

                {{#if isSelect}}

                    <div class="data-list-filter__field" data-list-filter-field data-filter-name="{{name}}"
                        data-filter-type="select" data-filter-source="{{source}}" data-filter-value-key="{{valueKey}}"
                        data-filter-label-key="{{labelKey}}" data-filter-multiple="{{multiple}}"
                        data-filter-allow-all="{{allowAll}}">

                        {{> forms/select
                            id=id
                            name=name
                            label=label
                            mode=mode
                            multiple=multiple
                            allowAll=allowAll
                            placeholder=placeholder
                            options=null
                        }}

                    </div>

                {{/if}}

            {{/each}}

        </div>

        <div class="data-list-filter__footer">

            <button type="button" class="data-list-btn data-list-btn--outline" data-list-filter-reset>

                Đặt lại

            </button>

            <button type="button" class="data-list-btn data-list-btn--primary" data-list-filter-apply>

                Áp dụng

            </button>

        </div>

    </div>

{{/if}}