<section class="data-list-card">

    {{#if listPage.showSearch}}
        <div class="data-list-card__toolbar">

            <div class="data-list-search">
                {{> forms/search
                    inputId=listPage.searchId
                    className="search-picker--data-list"
                    placeholder=listPage.searchPlaceholder
                    listSearch=true
                    showClear=true
                    hideDropdown=true
                }}
            </div>

            {{#if listPage.bulkActions.length}}
                <div class="data-list-bulk-actions">

                    {{#each listPage.bulkActions}}
                        <button
                            type="button"
                            class="data-list-btn {{className}}"
                            data-list-bulk-action="{{action}}"
                            disabled>

                            {{#if icon}}
                                <i class="{{icon}}"></i>
                            {{/if}}

                            <span data-list-bulk-label>
                                {{label}}
                            </span>

                        </button>
                    {{/each}}

                </div>
            {{/if}}

        </div>
    {{/if}}

    <div class="data-list-table-wrap">

        <table class="catalog-table data-list-table">

            <thead class="catalog-table__head">
                <tr>

                    {{#if listPage.selectable}}
                        <th
                            class="catalog-table__cell catalog-table__cell--center data-list-table__selection">

                            <div
                                class="data-list-selection-control"
                                data-list-select-all>

                                {{> forms/checkbox
                                    id="dataListSelectAllCheckbox"
                                    name="dataListSelectAllCheckbox"
                                    label=""
                                    checked=false
                                }}

                            </div>

                        </th>
                    {{/if}}

                    {{#if listPage.showIndex}}
                        <th
                            class="catalog-table__cell catalog-table__cell--index catalog-table__cell--center data-list-table__index">

                            STT

                        </th>
                    {{/if}}

                    {{#each listPage.columns}}
                        <th
                            class="catalog-table__cell catalog-table__cell--center"
                            data-list-column
                            data-column-key="{{key}}"
                            data-column-type="{{type}}"
                            {{#if width}}style="width: {{width}}; min-width: {{width}};"{{/if}}>

                            {{#if sortable}}

                                <button
                                    type="button"
                                    class="data-list-sort-button"
                                    data-list-sort="{{key}}"
                                    aria-label="Sắp xếp theo {{label}}">

                                    <span class="data-list-sort-button__label">
                                        {{label}}
                                    </span>

                                    {{> table/sort-icon
                                        direction="none"
                                    }}

                                </button>

                            {{else}}

                                {{label}}

                            {{/if}}

                        </th>
                    {{/each}}

                    {{#if listPage.showRowActions}}
                        <th
                            class="catalog-table__cell catalog-table__cell--center data-list-table__actions-sticky"
                            data-list-row-actions-column>

                            Thao tác

                        </th>
                    {{/if}}

                </tr>
            </thead>

            <tbody
                class="catalog-table__body"
                data-list-body>

                <tr>
                    <td
                        class="catalog-table__cell data-list-table__empty"
                        colspan="{{listPage.colspan}}">

                        Đang tải dữ liệu...

                    </td>
                </tr>

            </tbody>

        </table>

    </div>

    <footer class="data-list-card__footer">
        {{> catalog/pagination}}
    </footer>

    {{#if listPage.selectable}}

        <template data-list-row-checkbox-template>

            <div class="data-list-selection-control">

                {{> forms/checkbox
                    id="dataListRowCheckboxTemplate"
                    name="dataListRowCheckbox"
                    label=""
                    checked=false
                }}

            </div>

        </template>

    {{/if}}

</section>