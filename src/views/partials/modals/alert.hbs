<div id='alertModal' class='modal' data-modal='alert' hidden>

    <div class='modal__backdrop' data-modal-close>
    </div>

    <div class='modal__dialog modal__dialog--small' role='dialog' aria-modal='true' aria-labelledby='alertModalTitle'>

        <header class='modal__header'>

            <h2 id='alertModalTitle' class='modal__title' data-alert-title>

                Thông báo

            </h2>

            <button type='button' class='modal__close' data-modal-close>

                ×

            </button>

        </header>

        <div class='modal__body'>

            <div class='modal__icon' data-alert-icon>

                ℹ️

            </div>

            <p class='modal__message' data-alert-message>

                Nội dung thông báo.

            </p>

        </div>

        <footer class='modal__footer'>

            <button type='button' class='btn btn-primary' data-modal-close>

                Đóng

            </button>

        </footer>

    </div>

</div>