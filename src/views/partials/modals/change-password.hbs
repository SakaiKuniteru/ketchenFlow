<div id='changePasswordModal' class='modal' data-modal='change-password' hidden>

    <div class='modal__backdrop'>
    </div>

    <section
        class='modal__dialog modal__dialog--change-password'
        role='dialog'
        aria-modal='true'
        aria-labelledby='changePasswordModalTitle'
    >

        <header class='modal__header'>

            <div class='modal__heading'>

                <span class='change-password-modal__icon' aria-hidden='true'>

                    <svg
                        viewBox='0 0 24 24'
                        fill='none'
                        stroke='currentColor'
                        stroke-width='1.8'
                        stroke-linecap='round'
                        stroke-linejoin='round'
                    >

                        <rect x='5' y='10' width='14' height='10' rx='2'>
                        </rect>

                        <path d='M8 10V7a4 4 0 0 1 8 0v3'>
                        </path>

                        <path d='M12 14v2'>
                        </path>

                    </svg>

                </span>

                <div>

                    <h2 id='changePasswordModalTitle' class='modal__title'>
                        Đổi mật khẩu
                    </h2>

                    <p class='modal__subtitle'>
                        Vui lòng nhập mật khẩu hiện tại và mật khẩu mới.
                    </p>

                </div>

            </div>

            <button type='button' class='modal__close' data-modal-close aria-label='Đóng'>
                ×
            </button>

        </header>

        <form id='changePasswordForm' class='change-password-form' autocomplete='off' novalidate>

            <div class='modal__body'>

                <div class='form-field' data-form-field='matKhauCu'>

                    <label for='matKhauCu' class='form-field__label'>

                        Mật khẩu hiện tại

                        <span class='form-field__required'>
                            *
                        </span>

                    </label>

                    <div class='password-field'>

                        <input
                            type='password'
                            id='matKhauCu'
                            name='matKhauCu'
                            class='form-input'
                            placeholder='Nhập mật khẩu hiện tại'
                            autocomplete='current-password'
                        />

                        <button
                            type='button'
                            class='password-field__toggle'
                            data-password-toggle
                            aria-label='Hiện mật khẩu'
                            aria-pressed='false'
                        >

                            <svg
                                class='password-field__icon password-field__icon--show'
                                viewBox='0 0 24 24'
                                fill='none'
                                stroke='currentColor'
                                stroke-width='1.8'
                                stroke-linecap='round'
                                stroke-linejoin='round'
                                aria-hidden='true'
                            >

                                <path d='M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6'>
                                </path>

                                <circle cx='12' cy='12' r='2.5'>
                                </circle>

                            </svg>

                            <svg
                                class='password-field__icon password-field__icon--hide'
                                viewBox='0 0 24 24'
                                fill='none'
                                stroke='currentColor'
                                stroke-width='1.8'
                                stroke-linecap='round'
                                stroke-linejoin='round'
                                aria-hidden='true'
                            >

                                <path d='M3 3l18 18'></path>

                                <path d='M10.6 10.7a2.5 2.5 0 0 0 3.4 3.4'>
                                </path>

                                <path d='M9.9 4.3A10.8 10.8 0 0 1 12 4c6 0 9.5 8 9.5 8a17.7 17.7 0 0 1-2.1 3.1'>
                                </path>

                                <path d='M6.6 6.6C4.1 8.3 2.5 12 2.5 12s3.5 8 9.5 8a10 10 0 0 0 4.1-.9'>
                                </path>

                            </svg>

                        </button>

                    </div>

                    <small class='form-field__error' data-field-error='matKhauCu' hidden>
                    </small>

                </div>

                <div class='form-field' data-form-field='matKhauMoi'>

                    <label for='matKhauMoi' class='form-field__label'>

                        Mật khẩu mới

                        <span class='form-field__required'>
                            *
                        </span>

                    </label>

                    <div class='password-field'>

                        <input
                            type='password'
                            id='matKhauMoi'
                            name='matKhauMoi'
                            class='form-input'
                            placeholder='Nhập mật khẩu mới'
                            autocomplete='new-password'
                        />

                        <button
                            type='button'
                            class='password-field__toggle'
                            data-password-toggle
                            aria-label='Hiện mật khẩu'
                            aria-pressed='false'
                        >

                            <svg
                                class='password-field__icon password-field__icon--show'
                                viewBox='0 0 24 24'
                                fill='none'
                                stroke='currentColor'
                                stroke-width='1.8'
                                stroke-linecap='round'
                                stroke-linejoin='round'
                                aria-hidden='true'
                            >

                                <path d='M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6'>
                                </path>

                                <circle cx='12' cy='12' r='2.5'>
                                </circle>

                            </svg>

                            <svg
                                class='password-field__icon password-field__icon--hide'
                                viewBox='0 0 24 24'
                                fill='none'
                                stroke='currentColor'
                                stroke-width='1.8'
                                stroke-linecap='round'
                                stroke-linejoin='round'
                                aria-hidden='true'
                            >

                                <path d='M3 3l18 18'></path>

                                <path d='M10.6 10.7a2.5 2.5 0 0 0 3.4 3.4'>
                                </path>

                                <path d='M9.9 4.3A10.8 10.8 0 0 1 12 4c6 0 9.5 8 9.5 8a17.7 17.7 0 0 1-2.1 3.1'>
                                </path>

                                <path d='M6.6 6.6C4.1 8.3 2.5 12 2.5 12s3.5 8 9.5 8a10 10 0 0 0 4.1-.9'>
                                </path>

                            </svg>

                        </button>

                    </div>

                    <div class='password-requirements' aria-label='Yêu cầu mật khẩu'>

                        <p class='password-requirements__title'>
                            Mật khẩu phải có:
                        </p>

                        <ul class='password-requirements__list'>

                            <li data-password-rule='length'>
                                Ít nhất 8 ký tự
                            </li>
                            <li data-password-rule='lowercase'>
                                Ít nhất một chữ thường
                            </li>
                            <li data-password-rule='uppercase'>
                                Ít nhất một chữ hoa
                            </li>
                            <li data-password-rule='number'>
                                Ít nhất một chữ số
                            </li>
                            <li data-password-rule='special'>
                                Ít nhất một ký tự đặc biệt
                            </li>
                            <li data-password-rule='no-space'>
                                Không chứa khoảng trắng
                            </li>
                        </ul>
                    </div>
                    <small class='form-field__error' data-field-error='matKhauMoi' hidden>
                    </small>
                </div>
                <div class='form-field' data-form-field='xacNhanMatKhauMoi'>
                    <label for='xacNhanMatKhauMoi' class='form-field__label'>
                        Nhập lại mật khẩu mới
                        <span class='form-field__required'>
                            *
                        </span>
                    </label>
                    <div class='password-field'>
                        <input
                            type='password'
                            id='xacNhanMatKhauMoi'
                            name='xacNhanMatKhauMoi'
                            class='form-input'
                            placeholder='Nhập lại mật khẩu mới'
                            autocomplete='new-password'
                        />
                        <button
                            type='button'
                            class='password-field__toggle'
                            data-password-toggle
                            aria-label='Hiện mật khẩu'
                            aria-pressed='false'
                        >
                            <svg
                                class='password-field__icon password-field__icon--show'
                                viewBox='0 0 24 24'
                                fill='none'
                                stroke='currentColor'
                                stroke-width='1.8'
                                stroke-linecap='round'
                                stroke-linejoin='round'
                                aria-hidden='true'
                            >
                                <path d='M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6'>
                                </path>
                                <circle cx='12' cy='12' r='2.5'>
                                </circle>
                            </svg>
                            <svg
                                class='password-field__icon password-field__icon--hide'
                                viewBox='0 0 24 24'
                                fill='none'
                                stroke='currentColor'
                                stroke-width='1.8'
                                stroke-linecap='round'
                                stroke-linejoin='round'
                                aria-hidden='true'
                            >
                                <path d='M3 3l18 18'></path>
                                <path d='M10.6 10.7a2.5 2.5 0 0 0 3.4 3.4'>
                                </path>
                                <path d='M9.9 4.3A10.8 10.8 0 0 1 12 4c6 0 9.5 8 9.5 8a17.7 17.7 0 0 1-2.1 3.1'>
                                </path>
                                <path d='M6.6 6.6C4.1 8.3 2.5 12 2.5 12s3.5 8 9.5 8a10 10 0 0 0 4.1-.9'>
                                </path>
                            </svg>
                        </button>
                    </div>
                    <small class='form-field__error' data-field-error='xacNhanMatKhauMoi' hidden>
                    </small>
                </div>
            </div>
            <footer class='modal__footer'>
                <button type='button' class='modal-button modal-button--secondary' data-modal-close>
                    Hủy
                </button>
                <button type='submit' class='modal-button modal-button--primary'>
                    <span data-change-password-label>
                        Đổi mật khẩu
                    </span>
                    <span class='modal-button__spinner' data-change-password-spinner hidden>
                    </span>
                </button>
            </footer>
        </form>
    </section>
</div>