<div class="form-field {{#if fieldClass}}{{fieldClass}}{{/if}}" data-form-field="{{name}}">

    {{#if label}}

        <label for="{{id}}" class="form-field__label">

            <span>
                {{label}}
            </span>

            {{#if required}}

                <span class="form-field__required" aria-hidden="true">
                    *
                </span>

            {{/if}}

        </label>

    {{/if}}

    <div class="form-field__control">

        <textarea id="{{id}}" name="{{name}}" class="form-textarea {{#if inputClass}}{{inputClass}}{{/if}}"
            rows="{{#if rows}}{{rows}}{{else}}4{{/if}}"
            data-editable-in-view="{{#if editableInView}}true{{else}}false{{/if}}" {{#if placeholder}}
            placeholder="{{placeholder}}" {{/if}} {{#if maxlength}} maxlength="{{maxlength}}" {{/if}} {{#if minlength}}
            minlength="{{minlength}}" {{/if}} {{#if required}} required aria-required="true" {{/if}} {{#if readonly}}
            readonly {{/if}} {{#if disabled}} disabled {{/if}} {{#if error}} aria-invalid="true"
            aria-describedby="{{id}}Error" {{else if description}} aria-describedby="{{id}}Description"
            {{/if}}>{{value}}</textarea>

    </div>

    <div class="form-field__meta">

        {{#if description}}

            <small id="{{id}}Description" class="form-field__description">
                {{description}}
            </small>

        {{/if}}

        {{#if showCounter}}

            <small class="form-field__counter" data-character-counter="{{id}}">

                <span data-character-current>
                    0
                </span>

                {{#if maxlength}}

                    <span aria-hidden="true">
                        /
                    </span>

                    <span>
                        {{maxlength}}
                    </span>

                {{/if}}

            </small>

        {{/if}}

    </div>

    <small id="{{id}}Error" class="form-field__error" data-field-error="{{name}}" {{#unless error}}hidden{{/unless}}>

        {{error}}

    </small>

</div>