<div class="form-field {{#if fieldClass}}{{fieldClass}}{{/if}}" data-form-field="{{name}}">

    {{#if label}}

        <label class="form-field__label" for="{{id}}">

            <span>
                {{label}}
            </span>

            {{#if required}}

                <span class="form-field__required" aria-hidden="true">
                    *
                </span>

            {{/if}}

        </label>

    {{/if}}

    <div class="file-picker" data-file-picker>

        <div class="file-picker__control">

            <span class="file-picker__icon" aria-hidden="true">

                <i class="fa-solid fa-paperclip"></i>

            </span>

            <button type="button" class="file-picker__name" data-file-picker-name data-file-picker-download
                title="Tải file xuống">

                {{#if value}}
                    {{value}}
                {{else}}
                    {{#if placeholder}}
                        {{placeholder}}
                    {{else}}
                        Chưa chọn file
                    {{/if}}
                {{/if}}

            </button>

            <label class="file-picker__action" for="{{id}}" data-file-picker-upload title="Tải file lên">

                <i class="fa-solid fa-cloud-arrow-up" aria-hidden="true">
                </i>

            </label>

        </div>

        <input id="{{id}}" name="{{name}}" class="file-picker__input" type="file" data-file-picker-input {{#if accept}}
            accept="{{accept}}" {{/if}} {{#if required}} required aria-required="true" {{/if}} {{#if disabled}} disabled
            {{/if}}>

    </div>

    <small id="{{id}}Error" class="form-field__error" data-field-error="{{name}}" {{#unless error}}hidden{{/unless}}>

        {{error}}

    </small>

</div>