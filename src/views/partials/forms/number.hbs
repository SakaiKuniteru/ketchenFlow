<div class="form-field {{#if fieldClass}}{{fieldClass}}{{/if}}" data-form-field="{{name}}">

    {{#if label}}

        <label for="{{id}}" class="form-field__label">

            <span>
                {{label}}
            </span>

            {{#if required}}

                <span class="form-field__required" aria-hidden="true">
                    *
                </span>

            {{/if}}

        </label>

    {{/if}}

    <div class="form-field__control">

        {{#if prefix}}

            <span class="form-field__prefix">
                {{prefix}}
            </span>

        {{/if}}

        <input type="text" id="{{id}}" name="{{name}}"
            class="form-input form-input--number {{#if inputClass}}{{inputClass}}{{/if}}" value="{{value}}"
            data-number-input data-number-min="{{min}}" data-number-max="{{max}}"
            data-number-step="{{#if step}}{{step}}{{else}}any{{/if}}"
            data-number-integer="{{#if integer}}true{{else}}false{{/if}}"
            data-number-allow-sign="{{#if allowSign}}true{{else}}false{{/if}}" {{#if placeholder}}
            placeholder="{{placeholder}}" {{/if}} inputmode="{{#if integer}}numeric{{else}}decimal{{/if}}"
            {{#if required}} required aria-required="true" {{/if}} {{#if readonly}} readonly {{/if}} {{#if disabled}}
            disabled {{/if}} {{#if error}} aria-invalid="true" aria-describedby="{{id}}Error" {{else if description}}
            aria-describedby="{{id}}Description" {{/if}}>

        {{#if suffix}}

            <span class="form-field__suffix">
                {{suffix}}
            </span>

        {{/if}}

    </div>

    {{#if description}}

        <small id="{{id}}Description" class="form-field__description">
            {{description}}
        </small>

    {{/if}}

    <small id="{{id}}Error" class="form-field__error" data-field-error="{{name}}" {{#unless error}}hidden{{/unless}}>

        {{error}}

    </small>

</div>