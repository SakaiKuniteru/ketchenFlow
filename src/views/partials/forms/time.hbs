<div class="form-field {{#if fieldClass}}{{fieldClass}}{{/if}}" data-form-field="{{name}}" data-time-picker
    data-show-seconds="{{#if showSeconds}}true{{else}}false{{/if}}">

    {{#if label}}

        <label for="{{id}}" class="form-field__label">

            <span>
                {{label}}
            </span>

            {{#if required}}

                <span class="form-field__required" aria-hidden="true">
                    *
                </span>

            {{/if}}

        </label>

    {{/if}}


    <div class="time-picker">

        <div class="time-picker__control">

            <input type="text" id="{{id}}" name="{{name}}" value="{{value}}"
                class="form-input time-picker__input {{#if inputClass}}{{inputClass}}{{/if}}"
                placeholder="{{#if placeholder}}{{placeholder}}{{else}}{{#if showSeconds}}HH:mm:ss{{else}}HH:mm{{/if}}{{/if}}"
                inputmode="numeric" autocomplete="off" maxlength="{{#if showSeconds}}8{{else}}5{{/if}}" data-time-input
                {{#if required}} required aria-required="true" {{/if}} {{#if readonly}} readonly {{/if}}
                {{#if disabled}} disabled {{/if}} {{#if error}} aria-invalid="true" aria-describedby="{{id}}Error"
                {{else if description}} aria-describedby="{{id}}Description" {{/if}}>

            <button type="button" class="time-picker__toggle" data-time-toggle aria-label="Chọn thời gian"
                aria-expanded="false" {{#if readonly}} disabled {{/if}} {{#if disabled}} disabled {{/if}}>

                <i class="fa-regular fa-clock" aria-hidden="true">
                </i>

            </button>

        </div>


        <div class="time-picker__dropdown" data-time-dropdown hidden>

            <div class="time-picker__fields">

                <div class="time-picker__field">

                    <span class="time-picker__label">
                        Giờ
                    </span>

                    <div class="time-picker__number">

                        <button type="button" class="time-picker__step" data-time-step="hour" data-time-direction="1"
                            aria-label="Tăng giờ">

                            <i class="fa-solid fa-chevron-up"></i>

                        </button>

                        <input type="text" class="time-picker__number-input" inputmode="numeric" maxlength="2"
                            placeholder="00" data-time-hour aria-label="Giờ">

                        <button type="button" class="time-picker__step" data-time-step="hour" data-time-direction="-1"
                            aria-label="Giảm giờ">

                            <i class="fa-solid fa-chevron-down"></i>

                        </button>

                    </div>

                </div>


                <span class="time-picker__separator">
                    :
                </span>


                <div class="time-picker__field">

                    <span class="time-picker__label">
                        Phút
                    </span>

                    <div class="time-picker__number">

                        <button type="button" class="time-picker__step" data-time-step="minute" data-time-direction="1"
                            aria-label="Tăng phút">

                            <i class="fa-solid fa-chevron-up"></i>

                        </button>

                        <input type="text" class="time-picker__number-input" inputmode="numeric" maxlength="2"
                            placeholder="00" data-time-minute aria-label="Phút">

                        <button type="button" class="time-picker__step" data-time-step="minute" data-time-direction="-1"
                            aria-label="Giảm phút">

                            <i class="fa-solid fa-chevron-down"></i>

                        </button>

                    </div>

                </div>


                {{#if showSeconds}}

                    <span class="time-picker__separator">
                        :
                    </span>


                    <div class="time-picker__field">

                        <span class="time-picker__label">
                            Giây
                        </span>

                        <div class="time-picker__number">

                            <button type="button" class="time-picker__step" data-time-step="second"
                                data-time-direction="1" aria-label="Tăng giây">

                                <i class="fa-solid fa-chevron-up"></i>

                            </button>

                            <input type="text" class="time-picker__number-input" inputmode="numeric" maxlength="2"
                                placeholder="00" data-time-second aria-label="Giây">

                            <button type="button" class="time-picker__step" data-time-step="second"
                                data-time-direction="-1" aria-label="Giảm giây">

                                <i class="fa-solid fa-chevron-down"></i>

                            </button>

                        </div>

                    </div>

                {{/if}}

            </div>


            <div class="time-picker__footer">

                <button type="button" class="time-picker__footer-button" data-time-clear>

                    Xóa

                </button>


                <button type="button" class="time-picker__footer-button time-picker__footer-button--primary"
                    data-time-confirm>

                    Xong

                </button>

            </div>

        </div>

    </div>


    {{#if description}}

        <small id="{{id}}Description" class="form-field__description">

            {{description}}

        </small>

    {{/if}}


    <small id="{{id}}Error" class="form-field__error" data-field-error="{{name}}" {{#unless error}}hidden{{/unless}}>

        {{error}}

    </small>

</div>