<span class="
        status-badge
        {{#if statusClass}}
            status-badge--{{statusClass}}
        {{else}}
            status-badge--default
        {{/if}}
    " data-status="{{statusValue}}">

    {{#if showDot}}

        <span class="status-badge__dot" aria-hidden="true">
        </span>

    {{/if}}

    <span class="status-badge__label">

        {{#if statusLabel}}

            {{statusLabel}}

        {{else}}

            Không xác định

        {{/if}}

    </span>

</span>