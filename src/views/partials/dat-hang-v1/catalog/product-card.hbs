<article class="order-product-card"><div class="order-product-card__media"><img class="order-product-card__image" src="{{imageUrl hinhAnh}}" alt="{{tenSanPham}}" loading="lazy">{{#if laSanPhamNoiBat}}<span class="order-product-ribbon">Nổi bật</span>{{else if laSanPhamMoi}}<span class="order-product-ribbon is-new">Mới</span>{{/if}}</div><div class="order-product-card__body"><span class="order-product-card__tag order-category--{{loaiSanPham}}">{{categoryName loaiSanPham}}</span><h3>{{tenSanPham}}</h3><p>{{moTa}}</p><div class="order-product-card__bottom"><span class="order-price">{{money giaBan}}<small>/{{tenDonViTinh}}</small></span>{{#if quantity}}{{> dat-hang/catalog/quantity-control}}{{else}}<button type="button" class="order-button order-button--primary order-button--small" data-add="{{id}}">Chọn</button>{{/if}}</div></div></article>
