<div class="order-steps" aria-label="Tiến trình đặt hàng">
    <div class="order-step {{#if (eq activeStep 1)}}is-active{{else if (gt activeStep 1)}}is-done{{/if}}">
        <span>{{#if (gt activeStep 1)}}✓{{else}}1{{/if}}</span><strong>Giỏ hàng</strong><small>{{#if (gt activeStep 1)}}Đã hoàn thành{{else}}Đang thực hiện{{/if}}</small>
    </div>
    <i></i>
    <div class="order-step {{#if (eq activeStep 2)}}is-active{{else if (gt activeStep 2)}}is-done{{/if}}">
        <span>{{#if (gt activeStep 2)}}✓{{else}}2{{/if}}</span><strong>Thông tin nhận hàng</strong><small>{{#if (gt activeStep 2)}}Đã hoàn thành{{else if (eq activeStep 2)}}Đang thực hiện{{else}}Tiếp theo{{/if}}</small>
    </div>
    <i></i>
    <div class="order-step {{#if (eq activeStep 3)}}is-active{{else if (gt activeStep 3)}}is-done{{/if}}">
        <span>{{#if (gt activeStep 3)}}✓{{else}}3{{/if}}</span><strong>Xác nhận đơn hàng</strong><small>{{#if (gt activeStep 3)}}Đã hoàn thành{{else if (eq activeStep 3)}}Đang thực hiện{{else}}Tiếp theo{{/if}}</small>
    </div>
    <i></i>
    <div class="order-step {{#if (eq activeStep 4)}}is-active{{else if (gt activeStep 4)}}is-done{{/if}}">
        <span>4</span><strong>Hoàn tất</strong><small>{{#if (eq activeStep 4)}}Đang hiển thị{{else}}Tiếp theo{{/if}}</small>
    </div>
</div>
