<section class="order-cart"><header class="order-cart__header"><h2><i class="fa-solid fa-cart-shopping"></i> Giỏ hàng <span class="order-cart__count">{{items.length}}</span></h2>{{#if items.length}}<button class="order-cart-item__remove" type="button" data-clear-cart>Xóa tất cả</button>{{/if}}</header>{{#if items.length}}<div class="order-cart__items">{{#each items}}{{> dat-hang/cart/cart-item}}{{/each}}</div><div class="order-cart__footer">{{#if error}}<div class="order-notice order-notice--danger" role="alert">{{error}}</div>{{/if}}{{#if loading}}<p role="status">Đang tính lại giá...</p>{{/if}}{{> dat-hang/cart/cart-totals}}</div><div class="order-cart__footer">{{> dat-hang/cart/cart-note}}<p class="order-notice"><i class="fa-solid fa-circle-info"></i> Bạn có thể đặt nhiều loại món trong cùng một đơn.</p><a class="order-button order-button--outline" href="/dat-hang/danh-sach-don-hang-cua-toi">Đơn hàng của tôi</a><button type="button" class="order-button order-button--primary" data-checkout {{#if blocked}}disabled{{/if}}><i class="fa-solid fa-paper-plane"></i> Đặt hàng</button></div>{{else}}{{> dat-hang/cart/cart-empty}}{{/if}}</section>
