<section class="order-summary"><header class="order-summary__header"><h2><i class="fa-solid fa-calculator"></i> Tóm tắt đơn hàng</h2></header><div class="order-summary__body">{{#if receiver}}<dl class="order-info-list"><div><dt>Người nhận</dt><dd>{{receiver}}</dd></div><div><dt>Điện thoại</dt><dd>{{phone}}</dd></div><div><dt>Địa điểm</dt><dd>{{address}}</dd></div><div><dt>Thời gian nhận</dt><dd>{{deliveryTime}}</dd></div></dl>{{/if}}<div class="order-summary__items">{{#each items}}<div class="order-summary__item"><img src="{{imageUrl hinhAnh}}" alt="{{tenSanPham}}"><div><strong>{{tenSanPham}}</strong><small>× {{number soLuong}}</small></div><b>{{money thanhTien}}</b></div>{{/each}}</div><p class="order-help">{{items.length}} loại · {{number quantity}} sản phẩm</p>{{> dat-hang/cart/cart-totals}}</div><div class="order-summary__actions">{{#if error}}<p class="order-notice order-notice--danger" role="alert">{{error}}</p>{{/if}}<a class="order-button order-button--outline" href="{{backUrl}}"><i class="fa-solid fa-arrow-left"></i> {{backLabel}}</a>{{#if confirmation}}<button type="button" class="order-button order-button--primary" data-place-order {{#if blocked}}disabled{{/if}}><i class="fa-solid fa-paper-plane"></i> Xác nhận đặt hàng</button>{{else}}<button type="submit" form="orderDeliveryForm" class="order-button order-button--primary" {{#if blocked}}disabled{{/if}}><i class="fa-solid fa-arrow-right"></i> Tiếp tục xác nhận</button>{{/if}}<p class="order-help">Giá và ưu đãi được kiểm tra lại khi xác nhận đơn.</p></div></section>
