        <div>
            <h2>Đặt hàng thành công</h2>
            <p>Đơn {{maDonHang}} đã được gửi tới nhà ăn. Bạn có thể theo dõi tiến trình bên dưới.</p>

            <div class="order-action-row">
                <a href="/dat-hang/dat-mon" class="order-button order-button--outline">Tiếp tục mua hàng</a>
                <a href="/dat-hang/danh-sach-don-hang-cua-toi" class="order-button order-button--primary">Danh sách đơn hàng</a>
            </div>
        </div>
    </section>
{{/if}}

