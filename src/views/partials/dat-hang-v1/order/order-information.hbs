{{#> dat-hang/common/order-card
    title="Thông tin đơn hàng"
    icon="fa-solid fa-receipt"
}}
    <dl class="order-info-list order-info-list--two">
        <div>
            <dt>Mã đơn</dt>
            <dd>{{maDonHang}}</dd>
        </div>

        <div>
            <dt>Thời gian đặt</dt>
            <dd>{{dateTime createdAt}}</dd>
        </div>

        <div>
            <dt>Trạng thái</dt>
            <dd>{{> dat-hang/common/status-badge}}</dd>
        </div>

        <div>
            <dt>Người xử lý</dt>
            <dd>{{#if nguoiXuLy}}{{nguoiXuLy.hoTen}}{{else}}Chưa tiếp nhận{{/if}}</dd>
        </div>
    </dl>
{{/dat-hang/common/order-card}}