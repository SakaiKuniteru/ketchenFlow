<div class='order-table-wrap'>
    <table class='order-items'>
        <thead>
            <tr>
                <th>#</th>
                <th>Món / Dịch vụ</th>
                <th>Loại</th>
                <th>SL</th>
                <th>Đơn giá</th>
                <th>Thành tiền</th>
            </tr>
        </thead>

        <tbody>
            {{#each items}}
                <tr>
                    <td>{{inc @index}}</td>

                    <td>
                        <div class='order-item-product'>
                            <img
                                src='{{imageUrl hinhAnh}}'
                                alt='{{tenSanPham}}'
                            />
                            <strong>{{tenSanPham}}</strong>
                        </div>

                        {{#if ghiChu}}
                            <small>{{ghiChu}}</small>
                        {{/if}}
                    </td>

                    <td>
                        <span class='order-product-card__tag'>{{tenNhomSanPham}}</span>
                    </td>

                    <td>{{number soLuong}}</td>
                    <td>{{money donGia}}</td>
                    <td><strong>{{money thanhTien}}</strong></td>
                </tr>
            {{/each}}
        </tbody>
    </table>
</div>

<p class='order-help'>{{items.length}} loại · {{number quantity}} sản phẩm</p>