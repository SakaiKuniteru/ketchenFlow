{{#> dat-hang/common/order-card
    title="Theo dõi đơn hàng"
    icon="fa-solid fa-truck"
}}
    {{#if lyDoHuy}}
        <p class="order-notice order-notice--danger">{{lyDoHuy}}</p>
    {{/if}}

    <ol class="order-progress">
        {{#each progress}}
            <li class="{{className}}">
                <span><i class="fa-solid {{icon}}"></i></span>
                <strong>{{label}}</strong>
                <small>{{description}}</small>
            </li>
        {{/each}}
    </ol>
{{/dat-hang/common/order-card}}

{{#> dat-hang/common/order-card
    title="Lịch sử cập nhật"
    icon="fa-regular fa-clock"
}}
    <ol class="order-history">
        {{#each history}}
            <li>
                <span class="order-history__dot"></span>
                <div>
                    <time>{{dateTime createdAt}}</time>
                    <strong>{{#if noiDung}}{{noiDung}}{{else}}{{tenTrangThaiMoi}}{{/if}}</strong>
                    <small>{{tenNguoiThucHien}}</small>
                </div>
            </li>
        {{else}}
            <li>Chưa có lịch sử cập nhật.</li>
        {{/each}}
    </ol>
{{/dat-hang/common/order-card}}