{{#> dat-hang/common/order-card
    title="Thanh toán"
    icon="fa-solid fa-credit-card"
}}
    <dl class="order-info-list">
        <div>
            <dt>Phương thức</dt>
            <dd>{{paymentName phuongThucThanhToan}}</dd>
        </div>

        <div>
            <dt>Trạng thái</dt>
            <dd>{{> dat-hang/common/payment-status-badge}}</dd>
        </div>

        {{#each vouchers}}
            <div>
                <dt>Voucher</dt>
                <dd class="order-text-success">{{maVoucher}} · −{{money soTienGiam}}</dd>
            </div>
        {{/each}}
    </dl>

    {{#with tien}}
        {{> dat-hang/cart/cart-totals}}
    {{/with}}

    {{#if canPay}}
        <div class="order-payment-actions">
            <button type="button" class="order-button order-button--outline" data-payment-create>
                {{#if isQr}}Xem / tạo mã QR{{else}}Khởi tạo thanh toán{{/if}}
            </button>
        </div>
    {{/if}}

    <div data-payment-result></div>
{{/dat-hang/common/order-card}}