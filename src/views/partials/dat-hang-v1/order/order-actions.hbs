{{#> dat-hang/common/order-card
    title="Xử lý đơn hàng"
    icon="fa-solid fa-gear"
}}
    <div class="order-action-row">
        {{#each actions}}
            <button
                type="button"
                class="order-button order-button--{{theme}}"
                data-order-action="{{action}}"
            >
                <i class="fa-solid {{icon}}"></i> {{label}}
            </button>
        {{/each}}

        {{#if phoneLink}}
            <a class="order-button order-button--outline" href="{{phoneLink}}">
                <i class="fa-solid fa-phone"></i> Liên hệ người nhận
            </a>
        {{/if}}
    </div>

    {{#if actionHint}}
        <p class="order-notice">{{actionHint}}</p>
    {{/if}}
{{/dat-hang/common/order-card}}