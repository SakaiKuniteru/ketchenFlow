{{#if (eq type "filter")}}

    <form class="order-list-filters" data-order-filters hidden>
        {{> forms/select
            id="orderStatusFilter"
            name="trangThai"
            label="Trạng thái đơn"
            mode="single"
            multiple=false
            allowAll=false
            placeholder="Tất cả trạng thái"
            options=null
        }}

        {{> forms/select
            id="orderPaymentFilter"
            name="trangThaiThanhToan"
            label="Thanh toán"
            mode="single"
            multiple=false
            allowAll=false
            placeholder="Tất cả"
            options=null
        }}

        {{> forms/date
            id="orderFromDate"
            name="tuNgay"
            label="Từ ngày"
            placeholder="dd/mm/yyyy"
            defaultTime="00:00:00"
        }}

        {{> forms/date
            id="orderToDate"
            name="denNgay"
            label="Đến ngày"
            placeholder="dd/mm/yyyy"
            defaultTime="23:59:59"
        }}

        <div class="order-action-row">
            <button
                type="button"
                class="order-button order-button--outline"
                data-reset-filters
            >
                Xóa lọc
            </button>

            <button
                type="submit"
                class="order-button order-button--primary"
            >
                Áp dụng
            </button>
        </div>
    </form>

{{else if (eq type "statistics")}}

    {{#each statistics}}
        <div class="order-stat-card order-stat-card--{{theme}}">
            <span class="order-stat-card__icon">
                <i class="fa-solid {{icon}}"></i>
            </span>

            <div>
                <strong>{{number count}}</strong>
                <small>{{label}}</small>
            </div>
        </div>
    {{/each}}

{{else if (eq type "table-row")}}

    <tr
        class="{{#if selected}}is-selected{{/if}}"
        data-order-row="{{id}}"
    >
        <td>{{index}}</td>

        <td>
            <a
                href="{{detailUrl}}"
                data-order-select="{{id}}"
                class="order-code"
            >
                {{maDonHang}}
            </a>
        </td>

        <td>{{dateTime thoiGianDat}}</td>

        {{#if management}}
            <td>{{nguoiDat}}</td>
        {{/if}}

        <td>{{nguoiNhan}}</td>
        <td>{{soLoai}}</td>
        <td>{{number tongSoLuong}}</td>

        <td>
            <strong>{{money tongThanhToan}}</strong>
        </td>

        {{#if management}}
            <td>{{paymentName phuongThucThanhToan}}</td>
        {{/if}}

        <td>
            {{> dat-hang/dung-chung type="status"}}
        </td>
    </tr>

{{else if (eq type "table")}}

    <div class="order-table-wrap">
        <table class="order-table">
            <thead>
                <tr>
                    <th>STT</th>
                    <th>Mã đơn</th>
                    <th>Thời gian đặt</th>

                    {{#if management}}
                        <th>Người đặt</th>
                    {{/if}}

                    <th>Người nhận</th>
                    <th>Số loại</th>
                    <th>Tổng SL</th>
                    <th>Tổng tiền</th>

                    {{#if management}}
                        <th>PTTT</th>
                    {{/if}}

                    <th>Trạng thái</th>
                </tr>
            </thead>

            <tbody data-orders-table></tbody>
        </table>
    </div>

    <div
        class="order-pagination-wrap"
        data-orders-pagination
    >
        {{> catalog/pagination
            paginationId="orderListPagination"
        }}
    </div>

{{else if (eq type "detail-panel")}}

    {{> dat-hang/chi-tiet type="information"}}
    {{> dat-hang/chi-tiet type="receiver"}}

    {{#> dat-hang/dung-chung
        type="card"
        title="Món / Dịch vụ đã đặt"
        icon="fa-solid fa-utensils"
    }}
        {{> dat-hang/chi-tiet type="items"}}

        {{#with tien}}
            {{> dat-hang/dung-chung
                type="money-row"
                label="Tổng cộng"
                value=tongThanhToan
                grand=true
            }}
        {{/with}}
    {{/dat-hang/dung-chung}}

    {{> dat-hang/chi-tiet type="payment"}}
    {{> dat-hang/chi-tiet type="actions"}}
    {{> dat-hang/chi-tiet type="timeline"}}

{{/if}}