<div class='table-action-menu' data-action-menu>

    <button
        type='button'
        class='table-action-menu__trigger'
        data-action-menu-trigger
        aria-label='Mở danh sách thao tác'
        aria-haspopup='true'
        aria-expanded='false'
    >

        <span aria-hidden='true'>
            ⋮
        </span>

    </button>

    <div class='table-action-menu__dropdown' data-action-menu-dropdown role='menu' hidden>

        {{#if showView}}

            <button
                type='button'
                class='table-action-menu__item'
                data-action='view'
                data-record-id='{{recordId}}'
                role='menuitem'
            >

                <span class='table-action-menu__icon' aria-hidden='true'>
                    ◉
                </span>

                <span>
                    Xem chi tiết
                </span>

            </button>

        {{/if}}

        {{#if showEdit}}

            <button
                type='button'
                class='table-action-menu__item'
                data-action='edit'
                data-record-id='{{recordId}}'
                role='menuitem'
            >

                <span class='table-action-menu__icon' aria-hidden='true'>
                    ✎
                </span>

                <span>
                    Cập nhật
                </span>

            </button>

        {{/if}}

        {{#if showLock}}

            <button
                type='button'
                class='table-action-menu__item table-action-menu__item--warning'
                data-action='lock'
                data-record-id='{{recordId}}'
                role='menuitem'
            >

                <span class='table-action-menu__icon' aria-hidden='true'>
                    🔒
                </span>

                <span>
                    Khóa
                </span>

            </button>

        {{/if}}

        {{#if showUnlock}}

            <button
                type='button'
                class='table-action-menu__item table-action-menu__item--success'
                data-action='unlock'
                data-record-id='{{recordId}}'
                role='menuitem'
            >

                <span class='table-action-menu__icon' aria-hidden='true'>
                    🔓
                </span>

                <span>
                    Mở khóa
                </span>

            </button>

        {{/if}}

        {{#if showDelete}}

            <div class='table-action-menu__separator' role='separator'>
            </div>

            <button
                type='button'
                class='table-action-menu__item table-action-menu__item--danger'
                data-action='delete'
                data-record-id='{{recordId}}'
                role='menuitem'
            >

                <span class='table-action-menu__icon' aria-hidden='true'>
                    🗑
                </span>

                <span>
                    Xóa
                </span>

            </button>

        {{/if}}

    </div>

</div>