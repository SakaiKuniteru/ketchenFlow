<tr class="catalog-table__filter-row" data-table-filter-row hidden>

    {{#if selectable}}

        <th class="catalog-table__filter-cell"></th>

    {{/if}}

    {{#if showIndex}}

        <th class="catalog-table__filter-cell"></th>

    {{/if}}

    {{#each columns}}

        <th class="catalog-table__filter-cell">

            {{#if filterable}}

                {{#if filterOptions}}
                    <div class="catalog-table__filter-select" data-catalog-filter-select data-filter-key="{{key}}">
                        {{> forms/select
                                id=filterId
                                name=filterName
                                label=""
                                mode="single"
                                placeholder="Tất cả"
                                options=filterOptions
                                allowAll=true
                                description=""
                                required=false
                            }}
                    </div>
                {{else}}

                    <input type="{{#if filterType}}{{filterType}}{{else}}text{{/if}}"
                        class="catalog-table__filter-input" placeholder="Tìm {{label}}..." data-filter-key="{{key}}"
                        autocomplete="off" aria-label="Lọc theo {{label}}">

                {{/if}}

            {{/if}}

        </th>

    {{/each}}

</tr>