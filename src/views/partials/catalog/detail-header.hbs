<header class="detail-panel__header" data-detail-header>

    <div class="detail-panel__heading">

        <button type="button" class="detail-panel__back" data-detail-back aria-label="Quay lại danh sách"
            title="Quay lại danh sách">

            <i class="fa-solid fa-arrow-left" aria-hidden="true">
            </i>

        </button>


        <div class="detail-panel__heading-content">

            <h2 class="detail-panel__title" data-detail-title>

                {{#if title}}

                    {{title}}

                {{else}}

                    Thông tin

                {{/if}}

            </h2>


            <p class="detail-panel__subtitle" data-detail-subtitle {{#unless subtitle}}hidden{{/unless}}>

                {{subtitle}}

            </p>

        </div>

    </div>


    <div class="detail-panel__header-actions" data-detail-header-actions hidden>
    </div>

</header>