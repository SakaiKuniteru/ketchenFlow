<footer id="{{#if paginationId}}{{paginationId}}{{else}}catalogPagination{{/if}}" class="catalog-pagination"
    data-catalog-pagination>

    <div class="catalog-pagination__page-size">

        <span class="catalog-pagination__page-size-label">
            Hiển thị
        </span>

        <div class="catalog-pagination__size-picker" data-pagination-size-picker>

            <select data-pagination-size aria-label="Số bản ghi trên mỗi trang" hidden>

                <option value="10">
                    10 dòng
                </option>

                <option value="20" selected>
                    20 dòng
                </option>

                <option value="50">
                    50 dòng
                </option>

                <option value="100">
                    100 dòng
                </option>

            </select>


            <button type="button" class="catalog-pagination__size-button" data-pagination-size-toggle
                aria-expanded="false">

                <span data-pagination-size-label>
                    20 dòng
                </span>

                <i class="fa-solid fa-chevron-down" aria-hidden="true">
                </i>

            </button>


            <div class="catalog-pagination__size-menu" data-pagination-size-menu hidden>

                <button type="button" class="catalog-pagination__size-option" data-pagination-size-value="10">

                    10 dòng

                </button>

                <button type="button" class="catalog-pagination__size-option is-selected"
                    data-pagination-size-value="20">

                    20 dòng

                </button>

                <button type="button" class="catalog-pagination__size-option" data-pagination-size-value="50">

                    50 dòng

                </button>

                <button type="button" class="catalog-pagination__size-option" data-pagination-size-value="100">

                    100 dòng

                </button>

            </div>

        </div>

    </div>

    <div class="catalog-pagination__summary" aria-live="polite">

        <strong data-pagination-from>
            0
        </strong>

        <span>–</span>

        <strong data-pagination-to>
            0
        </strong>

        <span>trong</span>

        <strong data-pagination-total>
            0
        </strong>

        <span>bản ghi</span>

    </div>


    <nav class="catalog-pagination__navigation" aria-label="Điều hướng phân trang">

        <button type="button" class="catalog-pagination__button" data-pagination-first aria-label="Trang đầu"
            title="Trang đầu" disabled>

            <i class="fa-solid fa-angles-left" aria-hidden="true">
            </i>

        </button>


        <button type="button" class="catalog-pagination__button" data-pagination-previous aria-label="Trang trước"
            title="Trang trước" disabled>

            <i class="fa-solid fa-angle-left" aria-hidden="true">
            </i>

        </button>


        <span class="catalog-pagination__current" data-pagination-current-page>

            1

        </span>


        <button type="button" class="catalog-pagination__button" data-pagination-next aria-label="Trang tiếp theo"
            title="Trang tiếp theo" disabled>

            <i class="fa-solid fa-angle-right" aria-hidden="true">
            </i>

        </button>


        <button type="button" class="catalog-pagination__button" data-pagination-last aria-label="Trang cuối"
            title="Trang cuối" disabled>

            <i class="fa-solid fa-angles-right" aria-hidden="true">
            </i>

        </button>


        <span data-pagination-total-pages hidden>
            1
        </span>

    </nav>

</footer>