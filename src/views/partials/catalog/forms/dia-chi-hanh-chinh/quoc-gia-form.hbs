<div class="detail-panel__section">
    <h3 class="detail-panel__section-title">
        Thông tin quốc gia
    </h3>

    <div class="catalog-form-grid">
        {{> forms/input
            id="maQuocGia"
            name="maQuocGia"
            label="Mã quốc gia"
            placeholder="Ví dụ: VN"
            maxlength=10
            required=true
        }}

        {{> forms/input
            id="tenQuocGia"
            name="tenQuocGia"
            label="Tên quốc gia"
            placeholder="Việt Nam"
            maxlength=255
            required=true
        }}

        {{> forms/input
            id="tenTiengAnh"
            name="tenTiengAnh"
            label="Tên quốc gia tiếng Anh"
            placeholder="Vietnam"
            maxlength=255
        }}

        {{> forms/input
            id="tenVietTat"
            name="tenVietTat"
            label="Tên viết tắt"
            placeholder="VN"
            maxlength=50
        }}

        {{> forms/input
            id="maIso2"
            name="maIso2"
            label="Mã ISO2"
            placeholder="VN"
            maxlength=2
            required=true
        }}

        {{> forms/input
            id="maIso3"
            name="maIso3"
            label="Mã ISO3"
            placeholder="VNM"
            maxlength=3
            required=true
        }}

        <div class="catalog-form-grid__full">
            {{> forms/input
                id="maDienThoai"
                name="maDienThoai"
                label="Mã điện thoại"
                placeholder="+84"
                maxlength=10
            }}
        </div>
    </div>
</div>

<div class="detail-panel__section">
    {{> forms/checkbox
        id="active"
        name="active"
        label="Đang hoạt động"
        checked=true
    }}
</div>