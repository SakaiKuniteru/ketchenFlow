<div class="detail-panel__section">
    <h3 class="detail-panel__section-title">
        Thông tin quyền
    </h3>

    <div class="catalog-form-grid">
        {{> forms/input
            id="maQuyen"
            name="maQuyen"
            label="Mã quyền"
            placeholder="Nhập mã quyền"
            maxlength=50
            required=true
        }}

        {{> forms/input
            id="tenQuyen"
            name="tenQuyen"
            label="Tên quyền"
            placeholder="Nhập tên quyền"
            maxlength=100
            required=true
        }}

        <div class="catalog-form-grid__full">
            {{> forms/select
                id="dsNhomTinhNangId"
                name="dsNhomTinhNangId"
                label="Nhóm tính năng"
                mode="multiple"
                multiple=true
                allowAll=true
                allLabel="Tất cả"
                placeholder="Chọn nhóm tính năng..."
                required=true
            }}
        </div>

        <div class="catalog-form-grid__full">
            {{> forms/textarea
                id="moTa"
                name="moTa"
                label="Mô tả"
                placeholder="Nhập mô tả quyền"
                maxlength=500
                rows=4
                showCounter=true
                required=true
            }}
        </div>
    </div>
</div>

<div class="detail-panel__section">
    {{> forms/checkbox
        id="active"
        name="active"
        label="Đang hoạt động"
        checked=true
    }}
</div>