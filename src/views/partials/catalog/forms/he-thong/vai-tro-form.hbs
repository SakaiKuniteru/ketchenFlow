<div class="detail-panel__section">
    <h3 class="detail-panel__section-title">Thông tin vai trò</h3>

    <div class="catalog-form-grid">
        {{> forms/input
            id="maVaiTro"
            name="maVaiTro"
            label="Mã vai trò"
            placeholder="Nhập mã vai trò"
            maxlength=50
            required=true
        }}

        {{> forms/input
            id="tenVaiTro"
            name="tenVaiTro"
            label="Tên vai trò"
            placeholder="Nhập tên vai trò"
            maxlength=255
            required=true
        }}

        <div class="catalog-form-grid__full">
            {{> forms/textarea
                id="moTa"
                name="moTa"
                label="Mô tả"
                placeholder="Nhập mô tả vai trò"
                maxlength=500
                rows=4
                showCounter=true
                required=true
            }}
        </div>
    </div>
</div>

<div class="detail-panel__section vai-tro-quyen">
    <div class="vai-tro-quyen__heading">
        <h3 class="detail-panel__section-title">Danh sách quyền</h3>

        <button type="button" class="vai-tro-quyen__choose-button" data-vai-tro-open-permission hidden>
            <i class="fa-solid fa-check-double"></i>
            <span>Chọn quyền</span>
        </button>
    </div>

    <div class="vai-tro-quyen__detail-toolbar">
        <div class="vai-tro-quyen__detail-filter">
            {{> forms/select
                id="vaiTroDanhSachTrangThai"
                name="vaiTroDanhSachTrangThai"
                label=""
                mode="single"
                multiple=false
                allowAll=false
                placeholder="Đã có quyền"
            }}
        </div>

        <div class="vai-tro-quyen__detail-count" data-vai-tro-detail-count>0 quyền</div>
    </div>

    <div class="vai-tro-quyen__detail-list" data-vai-tro-detail-list></div>
</div>

<div class="detail-panel__section">
    {{> forms/checkbox
        id="active"
        name="active"
        label="Đang hoạt động"
        checked=true
    }}
</div>

<div class="vai-tro-permission-modal" data-vai-tro-permission-modal hidden>
    <div class="vai-tro-permission-modal__backdrop"></div>

    <div class="vai-tro-permission-modal__dialog" role="dialog" aria-modal="true"
        aria-labelledby="vaiTroPermissionModalTitle">
        <header class="vai-tro-permission-modal__header">
            <div>
                <h2 id="vaiTroPermissionModalTitle" class="vai-tro-permission-modal__title">Chọn quyền</h2>
                <p class="vai-tro-permission-modal__subtitle" data-vai-tro-popup-summary>Đã chọn 0 quyền</p>
            </div>

            <button type="button" class="vai-tro-permission-modal__close" data-vai-tro-permission-close
                aria-label="Đóng">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </header>

        <div class="vai-tro-permission-modal__body">
            <div class="vai-tro-permission-modal__toolbar">
                <div class="vai-tro-permission-modal__select-all">
                    {{> forms/checkbox
                        id="vaiTroPopupChonTatCa"
                        name="vaiTroPopupChonTatCa"
                        label="Chọn tất cả"
                    }}
                </div>

                <div class="vai-tro-permission-modal__filter">
                    {{> forms/select
                        id="vaiTroPopupTrangThai"
                        name="vaiTroPopupTrangThai"
                        label="Trạng thái quyền"
                        mode="multiple"
                        multiple=true
                        allowAll=true
                        allLabel="Tất cả"
                        placeholder="Đã có / Chưa có"
                        compactMultiple=true
                        checkboxOptions=true
                    }}
                </div>

                <div class="vai-tro-permission-modal__filter">
                    {{> forms/select
                        id="vaiTroPopupNhomTinhNang"
                        name="vaiTroPopupNhomTinhNang"
                        label="Nhóm tính năng"
                        mode="multiple"
                        multiple=true
                        allowAll=true
                        allLabel="Tất cả"
                        placeholder="Chọn nhóm tính năng"
                        compactMultiple=true
                        checkboxOptions=true
                    }}
                </div>

                <div class="vai-tro-permission-modal__search">
                    <label class="form-field__label" for="vaiTroPopupTimQuyen">Tìm kiếm</label>

                    {{> forms/search
                        inputId="vaiTroPopupTimQuyen"
                        className="search-picker--vai-tro-permission"
                        placeholder="Tìm theo mã hoặc tên quyền..."
                        listSearch=true
                        showClear=true
                        hideDropdown=true
                    }}
                </div>
            </div>

            <div class="vai-tro-permission-modal__list" data-vai-tro-popup-list></div>
        </div>

        <footer class="vai-tro-permission-modal__footer">
            <button type="button" class="vai-tro-permission-modal__button vai-tro-permission-modal__button--cancel"
                data-vai-tro-permission-cancel>Hủy bỏ</button>
            <button type="button" class="vai-tro-permission-modal__button vai-tro-permission-modal__button--save"
                data-vai-tro-permission-save>Lưu</button>
        </footer>
    </div>
</div>

<template id="vaiTroQuyenCheckboxTemplate">
    <div class="vai-tro-quyen__item" data-vai-tro-quyen-item>
        {{> forms/checkbox
            id="vaiTroQuyenTemplate"
            name="vaiTroQuyenTemplate"
            label="Quyền"
        }}
    </div>
</template>