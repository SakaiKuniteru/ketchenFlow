<div class="detail-panel__section">

    <h3 class="detail-panel__section-title">
        Thông tin cơ sở
    </h3>

    <div class="catalog-form-grid">

        {{> forms/input
            id="maCoSo"
            name="maCoSo"
            label="Mã cơ sở"
            placeholder="Nhập mã cơ sở"
            maxlength=50
            required=true
        }}

        {{> forms/input
            id="tenCoSo"
            name="tenCoSo"
            label="Tên cơ sở"
            placeholder="Nhập tên cơ sở"
            maxlength=150
            required=true
        }}


        {{> forms/select
            id="quocGiaId"
            name="quocGiaId"
            label="Quốc gia"
            mode="single"
            multiple=false
            allowAll=false
            placeholder="Chọn quốc gia..."
            required=true
        }}

        {{> forms/select
            id="tinhThanhId"
            name="tinhThanhId"
            label="Tỉnh/Thành"
            mode="single"
            multiple=false
            allowAll=false
            placeholder="Chọn quốc gia trước"
            required=true
        }}


        {{> forms/select
            id="xaPhuongId"
            name="xaPhuongId"
            label="Xã/Phường"
            mode="single"
            multiple=false
            allowAll=false
            placeholder="Chọn tỉnh/thành trước"
        }}

        {{> forms/textarea
            id="diaChi"
            name="diaChi"
            label="Địa chỉ"
            placeholder="Nếu để trống hệ thống sẽ tự ghép theo xã/phường, tỉnh/thành, quốc gia"
            maxlength=500
            rows=3
            showCounter=true
        }}

    </div>

</div>


<div class="detail-panel__section">

    <h3 class="detail-panel__section-title">
        Hình ảnh
    </h3>

    <div class="co-so-image-grid">

        {{> forms/image
            id="logo"
            name="logo"
            label="Logo"
            accept="image/jpeg,image/png,image/webp,image/x-icon"
            width=100
            height=100
            minWidth=100
            minHeight=100
            placeholder="Tải logo lên"
        }}

        {{> forms/image
            id="favicon"
            name="favicon"
            label="Favicon"
            accept="image/jpeg,image/png,image/webp,image/x-icon"
            width=100
            height=100
            minWidth=100
            minHeight=100
            placeholder="Tải favicon lên"
        }}

        {{> forms/image
            id="logoDoiTac"
            name="logoDoiTac"
            label="Logo đối tác"
            accept="image/jpeg,image/png,image/webp,image/x-icon"
            width=100
            height=100
            minWidth=100
            minHeight=100
            placeholder="Tải logo đối tác lên"
        }}

    </div>

</div>


<div class="detail-panel__section">

    {{> forms/checkbox
        id="active"
        name="active"
        label="Đang hoạt động"
        checked=true
    }}

</div>