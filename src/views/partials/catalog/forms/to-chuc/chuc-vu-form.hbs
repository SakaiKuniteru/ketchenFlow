<div class="detail-panel__section">
    <h3 class="detail-panel__section-title">
        Thông tin chức vụ
    </h3>
    <div class="catalog-form-grid">
        {{> forms/input
            id="maChucVu"
            name="maChucVu"
            label="Mã chức vụ"
            placeholder="Nhập mã chức vụ"
            maxlength=50
            required=true
        }}
        {{> forms/input
            id="tenChucVu"
            name="tenChucVu"
            label="Tên chức vụ"
            placeholder="Nhập tên chức vụ"
            maxlength=255
            required=true
        }}
        <div class="catalog-form-grid__full">
            {{> forms/textarea
                id="moTa"
                name="moTa"
                label="Mô tả"
                placeholder="Nhập mô tả chức vụ"
                maxlength=500
                rows=4
                showCounter=true
            }}
        </div>
    </div>
</div>

<div class="detail-panel__section">
    {{> forms/checkbox
        id="active"
        name="active"
        label="Đang hoạt động"
        checked=true
    }}
</div>