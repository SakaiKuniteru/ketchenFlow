<div class="detail-panel__section">

    <h3 class="detail-panel__section-title">
        Thông tin kho
    </h3>

    <div class="catalog-form-grid">

        {{> forms/input
            id="maKho"
            name="maKho"
            label="Mã kho"
            placeholder="Nhập mã kho"
            maxlength=50
            required=true
        }}

        {{> forms/input
            id="tenKho"
            name="tenKho"
            label="Tên kho"
            placeholder="Nhập tên kho"
            maxlength=150
            required=true
        }}


        {{> forms/select
            id="nhaAnId"
            name="nhaAnId"
            label="Nhà ăn"
            mode="single"
            multiple=false
            allowAll=false
            placeholder="Chọn nhà ăn..."
            required=true
        }}

        {{> forms/select
            id="loaiKho"
            name="loaiKho"
            label="Loại kho"
            mode="single"
            multiple=false
            allowAll=false
            placeholder="Chọn loại kho..."
            required=true
        }}


        {{> forms/input
            id="diaDiem"
            name="diaDiem"
            label="Địa điểm"
            placeholder="Nhập địa điểm kho"
            maxlength=255
        }}

        {{> forms/number
            id="dienTich"
            name="dienTich"
            label="Diện tích"
            placeholder="Nhập diện tích"
            min=0
            step="0.01"
            suffix="m²"
        }}

        {{> forms/number
            id="nhietDoToiThieu"
            name="nhietDoToiThieu"
            label="Nhiệt độ tối thiểu"
            placeholder="Nhập nhiệt độ tối thiểu"
            step="0.0001"
            suffix="°C"
            allowSign=true
        }}

        {{> forms/number
            id="nhietDoToiDa"
            name="nhietDoToiDa"
            label="Nhiệt độ tối đa"
            placeholder="Nhập nhiệt độ tối đa"
            step="0.0001"
            suffix="°C"
            allowSign=true
        }}


        {{> forms/textarea
            id="moTa"
            name="moTa"
            label="Mô tả"
            placeholder="Nhập mô tả kho"
            maxlength=500
            rows=4
            showCounter=true
        }}

        {{> forms/textarea
            id="ghiChu"
            name="ghiChu"
            label="Ghi chú"
            placeholder="Nhập ghi chú"
            maxlength=500
            rows=4
            showCounter=true
        }}

    </div>

</div>


<div class="detail-panel__section">

    {{> forms/checkbox
        id="active"
        name="active"
        label="Đang hoạt động"
        checked=true
    }}

</div>


<div
    class="detail-panel__section kho-quan-ly"
    data-kho-manager-section>

    <div class="kho-quan-ly__heading">

        <div>

            <h3 class="detail-panel__section-title">
                Nhân viên quản lý
            </h3>

            <p class="kho-quan-ly__description">
                Chỉ được chọn nhân viên quản lý thuộc nhà ăn của kho.
            </p>

        </div>


        <button
            type="button"
            class="kho-quan-ly__choose-button"
            data-kho-open-manager
            hidden>

            <i class="fa-solid fa-user-plus"></i>

            <span>
                Chọn nhân viên
            </span>

        </button>

    </div>


    <div
        class="kho-quan-ly__summary"
        data-kho-manager-summary
        hidden>

        <span data-kho-manager-count>
            0 nhân viên
        </span>

    </div>


    <div
        class="kho-quan-ly__list"
        data-kho-manager-list
        hidden>
    </div>

</div>


<div
    class="kho-manager-modal"
    data-kho-manager-modal
    hidden>

    <div class="kho-manager-modal__backdrop">
    </div>


    <div
        class="kho-manager-modal__dialog"
        role="dialog"
        aria-modal="true"
        aria-labelledby="khoManagerModalTitle">

        <header class="kho-manager-modal__header">

            <div>

                <h2
                    id="khoManagerModalTitle"
                    class="kho-manager-modal__title">
                    Chọn nhân viên quản lý
                </h2>

                <p
                    class="kho-manager-modal__subtitle"
                    data-kho-manager-popup-summary>
                    Đã chọn 0 nhân viên
                </p>

            </div>


            <button
                type="button"
                class="kho-manager-modal__close"
                data-kho-manager-close
                aria-label="Đóng">

                <i class="fa-solid fa-xmark"></i>

            </button>

        </header>


        <div class="kho-manager-modal__body">

            <div class="kho-manager-modal__toolbar">

                <div class="kho-manager-modal__search">

                    {{> forms/input
                        id="khoManagerSearch"
                        name="khoManagerSearch"
                        label="Tìm kiếm"
                        placeholder="Tìm theo mã hoặc tên nhân viên"
                    }}

                </div>


                <button
                    type="button"
                    class="kho-manager-modal__add"
                    data-kho-manager-add>

                    <i class="fa-solid fa-plus"></i>

                    <span>
                        Thêm mới
                    </span>

                </button>

            </div>


            <div class="kho-manager-modal__table-wrapper">

                <table class="kho-manager-table">

                    <thead>

                        <tr>

                            <th class="is-index">
                                STT
                            </th>

                            <th>
                                Nhân viên
                            </th>

                            <th>
                                Nhà ăn
                            </th>

                            <th>
                                Chức vụ
                            </th>

                            <th>
                                Phòng ban
                            </th>

                            <th class="is-status">
                                Trạng thái
                            </th>

                        </tr>

                    </thead>


                    <tbody data-kho-manager-popup-list>
                    </tbody>

                </table>

            </div>

        </div>


        <footer class="kho-manager-modal__footer">

            <button
                type="button"
                class="kho-manager-modal__button"
                data-kho-manager-cancel>
                Hủy bỏ
            </button>


            <button
                type="button"
                class="kho-manager-modal__button is-primary"
                data-kho-manager-save>
                Lưu
            </button>

        </footer>

    </div>

</div>


<template id="khoManagerRowTemplate">

    <tr data-kho-manager-row>

        <td class="is-index">

            <span data-kho-manager-index>
                1
            </span>

        </td>


        <td>

            {{> forms/select
                id="khoManagerEmployeeTemplate"
                name="khoManagerEmployeeTemplate"
                label=""
                mode="single"
                multiple=false
                allowAll=false
                placeholder="Chọn nhân viên..."
            }}

        </td>


        <td>

            {{> forms/input
                id="khoManagerCanteenTemplate"
                name="khoManagerCanteenTemplate"
                label=""
                disabled=true
            }}

        </td>


        <td>

            {{> forms/input
                id="khoManagerPositionTemplate"
                name="khoManagerPositionTemplate"
                label=""
                disabled=true
            }}

        </td>


        <td>

            {{> forms/input
                id="khoManagerDepartmentTemplate"
                name="khoManagerDepartmentTemplate"
                label=""
                disabled=true
            }}

        </td>


        <td class="is-status">

            {{> forms/checkbox
                id="khoManagerSelectedTemplate"
                name="khoManagerSelectedTemplate"
                label=""
            }}

        </td>

    </tr>

</template>