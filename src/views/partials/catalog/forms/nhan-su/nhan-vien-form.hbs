<div class="detail-panel__section">
    <h3 class="detail-panel__section-title">
        Thông tin nhân viên
    </h3>

    <div class="catalog-form-grid">
        {{> forms/input
            id="maNhanVien"
            name="maNhanVien"
            label="Mã nhân viên"
            placeholder="Nhập mã nhân viên"
            maxlength=50
            required=true
        }}

        {{> forms/input
            id="tenDangNhap"
            name="tenDangNhap"
            label="Tên tài khoản"
            placeholder=""
            disabled=true
        }}

        {{> forms/input
            id="hoTen"
            name="hoTen"
            label="Họ và tên"
            placeholder="Nhập họ và tên"
            maxlength=150
            required=true
        }}

        {{> forms/input
            id="maThe"
            name="maThe"
            label="Mã thẻ"
            placeholder="Nhập mã thẻ"
            maxlength=100
        }}

        {{> forms/date
            id="ngaySinh"
            name="ngaySinh"
            label="Ngày sinh"
            type="date"
        }}

        {{> forms/select
            id="gioiTinh"
            name="gioiTinh"
            label="Giới tính"
            mode="single"
            multiple=false
            allowAll=false
            placeholder="Chọn giới tính..."
        }}

        {{> forms/input
            id="email"
            name="email"
            label="Email"
            placeholder="example@kitchenflow.com"
            type="email"
            maxlength=150
        }}

        {{> forms/input
            id="soDienThoai"
            name="soDienThoai"
            label="Số điện thoại"
            placeholder="Nhập số điện thoại"
            maxlength=20
        }}

        {{> forms/select
            id="coSoId"
            name="coSoId"
            label="Cơ sở"
            mode="single"
            multiple=false
            allowAll=false
            placeholder="Chọn cơ sở..."
            required=true
        }}

        {{> forms/select
            id="quocGiaId"
            name="quocGiaId"
            label="Quốc gia"
            mode="single"
            multiple=false
            allowAll=false
            placeholder="Chọn quốc gia..."
            required=true
        }}

        {{> forms/select
            id="phongBanId"
            name="phongBanId"
            label="Phòng ban"
            mode="single"
            multiple=false
            allowAll=false
            placeholder="Chọn phòng ban..."
        }}

        {{> forms/select
            id="tinhThanhId"
            name="tinhThanhId"
            label="Tỉnh thành"
            mode="single"
            multiple=false
            allowAll=false
            placeholder="Chọn tỉnh thành..."
        }}

        {{> forms/select
            id="chucVuId"
            name="chucVuId"
            label="Chức vụ"
            mode="single"
            multiple=false
            allowAll=false
            placeholder="Chọn chức vụ..."
        }}

        {{> forms/select
            id="xaPhuongId"
            name="xaPhuongId"
            label="Xã phường"
            mode="single"
            multiple=false
            allowAll=false
            placeholder="Chọn xã phường..."
        }}

        <div class="catalog-form-grid__full">
            {{> forms/textarea
                id="diaChi"
                name="diaChi"
                label="Địa chỉ"
                placeholder="Nếu để trống hệ thống sẽ tự lấy theo xã/phường, tỉnh/thành, quốc gia"
                maxlength=500
                rows=2
                showCounter=true
            }}
        </div>

        {{> forms/image
            id="anhDaiDien"
            name="anhDaiDien"
            label="Ảnh đại diện"
            accept="image/jpeg,image/png,image/webp"
            width=100
            height=100
            minWidth=100
            minHeight=100
            placeholder="Tải ảnh lên"
        }}

        {{> forms/textarea
            id="ghiChu"
            name="ghiChu"
            label="Ghi chú"
            placeholder="Nhập ghi chú"
            maxlength=500
            rows=3
            showCounter=true
        }}
    </div>
</div>

<div class="detail-panel__section">
    {{> forms/checkbox
        id="active"
        name="active"
        label="Đang hoạt động"
        checked=true
    }}
</div>