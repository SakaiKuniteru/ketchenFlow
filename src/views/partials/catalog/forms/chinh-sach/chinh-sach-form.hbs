<div class="detail-panel__section">

    <h3 class="detail-panel__section-title">
        Thông tin chính sách
    </h3>

    <div class="catalog-form-grid">

        {{> forms/input
            id="maChinhSach"
            name="maChinhSach"
            label="Mã chính sách"
            placeholder="Nhập mã chính sách"
            maxlength=50
            required=true
        }}

        {{> forms/input
            id="tenChinhSach"
            name="tenChinhSach"
            label="Tên chính sách"
            placeholder="Nhập tên chính sách"
            maxlength=255
            required=true
        }}


        {{> forms/select
            id="loaiChinhSach"
            name="loaiChinhSach"
            label="Loại chính sách"
            mode="single"
            multiple=false
            allowAll=false
            placeholder="Chọn loại chính sách..."
            required=true
        }}

        {{> forms/select
            id="doiTuongApDungIds"
            name="doiTuongApDungIds"
            label="Đối tượng áp dụng"
            mode="multiple"
            multiple=true
            allowAll=true
            allLabel="Tất cả"
            placeholder="Chọn loại chính sách trước"
            disabled=true
            required=true
        }}


        {{> forms/select
            id="voucherIds"
            name="voucherIds"
            label="Voucher áp dụng"
            mode="multiple"
            multiple=true
            allowAll=true
            allLabel="Tất cả"
            placeholder="Chọn voucher..."
            required=true
        }}

        {{> forms/number
            id="mucDoUuTien"
            name="mucDoUuTien"
            label="Mức độ ưu tiên"
            placeholder="Nhập mức độ ưu tiên"
            min=1
            step="1"
            required=true
        }}


        <div class="catalog-form-grid__full">

            {{> forms/textarea
                id="moTa"
                name="moTa"
                label="Mô tả"
                placeholder="Nhập nội dung chính sách"
                maxlength=500
                rows=4
                showCounter=true
            }}

        </div>

    </div>

</div>


<div class="detail-panel__section">

    {{> forms/checkbox
        id="active"
        name="active"
        label="Đang hoạt động"
        checked=true
    }}

</div>