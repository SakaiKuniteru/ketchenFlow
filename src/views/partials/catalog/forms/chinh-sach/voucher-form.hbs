<div class="detail-panel__section">

    <h3 class="detail-panel__section-title">
        Thông tin voucher
    </h3>

    <div class="catalog-form-grid">

        {{> forms/input
            id="maVoucher"
            name="maVoucher"
            label="Mã voucher"
            placeholder="Nhập mã voucher"
            maxlength=50
            required=true
        }}

        {{> forms/input
            id="tenVoucher"
            name="tenVoucher"
            label="Tên voucher"
            placeholder="Nhập tên voucher"
            maxlength=255
            required=true
        }}

        {{> forms/select
            id="loaiMienGiam"
            name="loaiMienGiam"
            label="Loại miễn giảm"
            mode="single"
            multiple=false
            allowAll=false
            placeholder="Chọn loại miễn giảm..."
            required=true
        }}

        {{> forms/number
            id="giaTri"
            name="giaTri"
            label="Giá trị voucher"
            placeholder="Chọn loại miễn giảm trước"
            min=0
            step="any"
            required=true
            disabled=true
        }}

        {{> forms/number
            id="soLuong"
            name="soLuong"
            label="Số lượng"
            placeholder="Nhập số lượng"
            min=0
            step="1"
        }}

        {{> forms/number
            id="daSuDung"
            name="daSuDung"
            label="Đã sử dụng"
            placeholder="Nhập số lượng đã sử dụng"
            min=0
            step="1"
            disabled=true
        }}

        {{> forms/date
            id="thoiGianBatDau"
            name="thoiGianBatDau"
            label="Thời gian bắt đầu"
            type="date"
            required=true
        }}

        {{> forms/date
            id="thoiGianKetThuc"
            name="thoiGianKetThuc"
            label="Thời gian kết thúc"
            type="date"
        }}

        <div class="catalog-form-grid__full">

            {{> forms/textarea
                id="moTa"
                name="moTa"
                label="Mô tả"
                placeholder="Nhập mô tả voucher"
                maxlength=500
                rows=4
                showCounter=true
            }}

        </div>

    </div>

</div>


<div class="detail-panel__section">

    {{> forms/checkbox
        id="active"
        name="active"
        label="Đang hoạt động"
        checked=true
    }}

</div>