<div class="detail-panel__section">
    <h3 class="detail-panel__section-title">
        Thông tin voucher đơn hàng
    </h3>

<div
    class="catalog-form-grid"
    style="row-gap: 8px; column-gap: 16px;"
>
        {{> forms/input
            id="maVoucher"
            name="maVoucher"
            label="Mã voucher"
            placeholder="Nhập mã voucher..."
            maxlength=50
            required=true
        }}

        {{> forms/input
            id="tenVoucher"
            name="tenVoucher"
            label="Tên voucher"
            placeholder="Nhập tên voucher..."
            maxlength=255
            required=true
        }}

        {{> forms/select
            id="loaiGiam"
            name="loaiGiam"
            label="Loại miễn giảm"
            mode="single"
            multiple=false
            allowAll=false
            placeholder="Chọn loại miễn giảm..."
            required=true
        }}

        {{> forms/number
            id="giaTri"
            name="giaTri"
            label="Giá trị voucher"
            placeholder="Chọn loại miễn giảm trước"
            min=0
            step="any"
            required=true
            disabled=true
        }}

        {{> forms/number
            id="giamToiDa"
            name="giamToiDa"
            label="Giảm tối đa"
            placeholder="Nhập giảm tối đa..."
            min=0
            step="any"
        }}

        {{> forms/number
            id="giaTriDonHangToiThieu"
            name="giaTriDonHangToiThieu"
            label="Đơn hàng tối thiểu"
            placeholder="Nhập giá trị tối thiểu..."
            min=0
            step="any"
        }}

        {{> forms/number
            id="soLuongPhatHanh"
            name="soLuongPhatHanh"
            label="Số lượng phát hành"
            placeholder="Nhập số lượng phát hành..."
            min=1
            step=1
            integer=true
        }}

        {{> forms/number
            id="soLuotMoiNhanVien"
            name="soLuotMoiNhanVien"
            label="Lượt mỗi nhân viên"
            placeholder="Nhập số lượt mỗi nhân viên..."
            min=1
            step=1
            integer=true
        }}

    </div>
</div>

<div class="detail-panel__section">
    <h3 class="detail-panel__section-title">
        Phạm vi áp dụng
    </h3>

    <div class="catalog-form-grid voucher-scope-grid">

        {{> forms/select
            id="phamViApDung"
            name="phamViApDung"
            label="Phạm vi áp dụng"
            mode="single"
            multiple=false
            allowAll=false
            placeholder="Chọn phạm vi áp dụng..."
            required=true
        }}

        <div
            class="voucher-scope-field"
            data-voucher-scope-wrapper="all"
            hidden>

            {{> forms/input
                id="phamViApDungToanBo"
                name="phamViApDungToanBo"
                label="Áp dụng cho"
                value="Áp dụng cho toàn bộ đơn hàng"
                placeholder="Áp dụng cho toàn bộ đơn hàng"
                readonly=true
                disabled=true
            }}
        </div>

        <div
            class="voucher-scope-field"
            data-voucher-scope-wrapper="nhomSanPhamId"
            hidden>

            {{> forms/select
                id="nhomSanPhamId"
                name="nhomSanPhamId"
                label="Nhóm sản phẩm"
                mode="single"
                multiple=false
                allowAll=false
                placeholder="Chọn nhóm sản phẩm..."
            }}
        </div>

        <div
            class="voucher-scope-field"
            data-voucher-scope-wrapper="sanPhamId"
            hidden>

            {{> forms/select
                id="sanPhamId"
                name="sanPhamId"
                label="Sản phẩm"
                mode="single"
                multiple=false
                allowAll=false
                placeholder="Chọn sản phẩm..."
            }}
        </div>

    </div>
</div>

<div class="detail-panel__section">
    <h3 class="detail-panel__section-title">
        Đối tượng áp dụng
    </h3>

    <div class="catalog-form-grid">
        {{> forms/select
            id="coSoIds"
            name="coSoIds"
            label="Cơ sở"
            mode="multiple"
            multiple=true
            allowAll=true
            allLabel="Tất cả"
            compactMultiple=false
            placeholder="Chọn cơ sở áp dụng..."
        }}

        {{> forms/select
            id="nhaAnIds"
            name="nhaAnIds"
            label="Nhà ăn"
            mode="multiple"
            multiple=true
            allowAll=true
            allLabel="Tất cả"
            compactMultiple=false
            placeholder="Chọn nhà ăn áp dụng..."
        }}

        {{> forms/select
            id="chucVuIds"
            name="chucVuIds"
            label="Chức vụ"
            mode="multiple"
            multiple=true
            allowAll=true
            allLabel="Tất cả"
            compactMultiple=false
            placeholder="Chọn chức vụ áp dụng..."
        }}

        {{> forms/select
            id="nhanVienIds"
            name="nhanVienIds"
            label="Nhân viên"
            mode="multiple"
            multiple=true
            allowAll=true
            allLabel="Tất cả"
            compactMultiple=false
            placeholder="Chọn nhân viên áp dụng..."
        }}
    </div>
</div>

<div class="detail-panel__section">
    <h3 class="detail-panel__section-title">
        Thời gian áp dụng
    </h3>

    <div class="catalog-form-grid">
        {{> forms/date
            id="thoiGianBatDau"
            name="thoiGianBatDau"
            label="Thời gian bắt đầu"
            placeholder=""
            showTime=true
            defaultTime="00:00:00"
            required=true
        }}

        {{> forms/date
            id="thoiGianKetThuc"
            name="thoiGianKetThuc"
            label="Thời gian kết thúc"
            placeholder=""
            showTime=true
            defaultTime="23:59:59"
            required=true
        }}

        {{> forms/textarea
            id="moTa"
            name="moTa"
            label="Mô tả"
            placeholder="Nhập mô tả..."
            maxlength=1000
            rows=3
            showCounter=true
            fieldClass="catalog-form-grid__full"
            required=true
        }}
    </div>
</div>

<div class="detail-panel__section">
    <div class="voucher-flags-row">
        {{> forms/checkbox
            id="choPhepDungChung"
            name="choPhepDungChung"
            label="Cho phép dùng chung"
            checked=true
        }}

        {{> forms/checkbox
            id="tuDongApDung"
            name="tuDongApDung"
            label="Tự động áp dụng"
            checked=true
        }}

        {{> forms/checkbox
            id="active"
            name="active"
            label="Đang hoạt động"
            checked=true
        }}
    </div>
</div>
