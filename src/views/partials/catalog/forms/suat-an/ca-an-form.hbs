<div class="detail-panel__section">

    <h3 class="detail-panel__section-title">
        Thông tin ca ăn
    </h3>

    <div class="catalog-form-grid">

        {{> forms/input
            id="maCaAn"
            name="maCaAn"
            label="Mã ca ăn"
            placeholder="Nhập mã ca ăn"
            maxlength=50
            required=true
        }}

        {{> forms/input
            id="tenCaAn"
            name="tenCaAn"
            label="Tên ca ăn"
            placeholder="Nhập tên ca ăn"
            maxlength=100
            required=true
        }}

        {{> forms/time
            id="thoiGianBatDau"
            name="thoiGianBatDau"
            label="Thời gian bắt đầu"
            placeholder="HH:mm:ss"
            showSeconds=true
            required=true
        }}

        {{> forms/time
            id="thoiGianKetThuc"
            name="thoiGianKetThuc"
            label="Thời gian kết thúc"
            placeholder="HH:mm:ss"
            showSeconds=true
            required=true
        }}

    </div>

</div>

<div class="detail-panel__section">

    {{> forms/checkbox
        id="active"
        name="active"
        label="Đang hoạt động"
        checked=true
    }}

</div>