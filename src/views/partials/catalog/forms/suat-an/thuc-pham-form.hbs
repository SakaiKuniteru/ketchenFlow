<div class="detail-panel__section">

    <h3 class="detail-panel__section-title">
        Thông tin thực phẩm
    </h3>

    <div class="catalog-form-grid">

        {{> forms/input
            id="maThucPham"
            name="maThucPham"
            label="Mã thực phẩm"
            placeholder="Nhập mã thực phẩm"
            maxlength=50
            required=true
        }}

        {{> forms/input
            id="tenThucPham"
            name="tenThucPham"
            label="Tên thực phẩm"
            placeholder="Nhập tên thực phẩm"
            maxlength=150
            required=true
        }}

        {{> forms/number
            id="giaNhap"
            name="giaNhap"
            label="Giá nhập"
            placeholder="Nhập giá nhập"
            min=0
            step="0.01"
            suffix="VNĐ"
        }}

        {{> forms/number
            id="tyLeHaoHutDuKien"
            name="tyLeHaoHutDuKien"
            label="Tỷ lệ hao hụt dự kiến"
            placeholder="Nhập tỷ lệ hao hụt"
            min=0
            max=100
            step="0.01"
            suffix="%"
        }}

        {{> forms/select
            id="donViSoCapId"
            name="donViSoCapId"
            label="Đơn vị sơ cấp"
            mode="single"
            multiple=false
            allowAll=false
            placeholder="Chọn đơn vị sơ cấp..."
            required=true
        }}

        {{> forms/select
            id="donViSuDungId"
            name="donViSuDungId"
            label="Đơn vị sử dụng"
            mode="single"
            multiple=false
            allowAll=false
            placeholder="Chọn đơn vị sử dụng..."
            required=true
        }}

        {{> forms/number
            id="heSoQuyDoi"
            name="heSoQuyDoi"
            label="Hệ số quy đổi"
            placeholder="Ví dụ: 10"
            min=0.01
            step="0.01"
            required=true
        }}

        {{> forms/input
            id="quyCach"
            name="quyCach"
            label="Quy cách"
            placeholder="Ví dụ: 1 Bao = 10 KG"
            maxlength=255
            description="Nếu bỏ trống, hệ thống tự tạo theo đơn vị và hệ số quy đổi."
        }}

        {{> forms/select
            id="xuatXuId"
            name="xuatXuId"
            label="Xuất xứ"
            mode="single"
            multiple=false
            allowAll=false
            placeholder="Chọn quốc gia..."
        }}

        {{> forms/select
            id="dieuKienBaoQuan"
            name="dieuKienBaoQuan"
            label="Điều kiện bảo quản"
            mode="single"
            multiple=false
            allowAll=false
            placeholder="Chọn điều kiện bảo quản..."
        }}

        {{> forms/textarea
            id="moTa"
            name="moTa"
            label="Mô tả"
            placeholder="Nhập mô tả thực phẩm"
            maxlength=500
            rows=3
            showCounter=true
        }}

        {{> forms/textarea
            id="ghiChu"
            name="ghiChu"
            label="Ghi chú"
            placeholder="Nhập ghi chú"
            maxlength=500
            rows=3
            showCounter=true
        }}

        {{> forms/image
            id="hinhAnh"
            name="hinhAnh"
            label="Hình ảnh"
            accept="image/jpeg,image/png,image/webp"
            width=100
            height=100
            minWidth=100
            minHeight=100
            placeholder="Tải ảnh lên"
        }}

    </div>

</div>

<div class="thuc-pham-active-field">
    {{> forms/checkbox
        id="active"
        name="active"
        label="Đang hoạt động"
        checked=true
    }}
</div>