<section id="{{#if pageId}}{{pageId}}{{else}}catalogPage{{/if}}"
    class="catalog-page {{#if pageClass}}{{pageClass}}{{/if}}" data-catalog-page data-module="{{moduleName}}">

    <div class="catalog-page__list">

        <div class="catalog-page__list-content">

            {{#if @partial-block}}

                {{> @partial-block}}

            {{/if}}

        </div>

    </div>

    <aside id="{{#if detailPanelId}}{{detailPanelId}}{{else}}catalogDetailPanel{{/if}}" class="catalog-page__detail"
        data-catalog-detail-panel data-panel-mode="view" aria-label="Thông tin chi tiết">

        <div class="catalog-page__detail-content">

            {{#if detailPartial}}

                {{> (lookup . "detailPartial")}}

            {{/if}}

        </div>

    </aside>

    <div class="catalog-page__overlay" data-catalog-overlay hidden>
    </div>

</section>