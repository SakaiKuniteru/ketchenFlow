<header class="catalog-toolbar {{#if toolbarClass}}{{toolbarClass}}{{/if}}" data-catalog-toolbar>

    <div class="catalog-toolbar__top">
        <div class="catalog-toolbar__heading">
            <div class="catalog-toolbar__title-group">
                <h1 class="catalog-toolbar__title">
                    {{#if title}}
                        {{title}}
                    {{else}}
                        Danh mục
                    {{/if}}
                </h1>

                {{#if description}}
                    <p class="catalog-toolbar__description">
                        {{description}}
                    </p>
                {{/if}}
            </div>

            {{#if totalLabel}}
                <span class="catalog-toolbar__total" data-catalog-total>
                    {{totalLabel}}
                </span>
            {{/if}}
        </div>

        <div class="catalog-toolbar__search">
            {{> forms/search
                inputId=searchInputId
                className="search-picker--catalog"
                placeholder=searchPlaceholder
                catalogSearch=true
                showClear=true
                hideDropdown=true
            }}

        </div>
    </div>

    <div class="catalog-toolbar__bottom">
        <div class="catalog-toolbar__actions">
            <div class="catalog-toolbar__utility" data-catalog-utility>
                <button type="button" class="catalog-toolbar__button catalog-toolbar__button--secondary"
                    data-catalog-utility-toggle aria-expanded="false">
                    <span aria-hidden="true">
                        ⚙
                    </span>
                    <span>
                        Tiện ích
                    </span>
                </button>

                <div class="catalog-toolbar__utility-menu" data-catalog-utility-menu hidden>
                </div>
            </div>

            <button type="button" class="
                    catalog-toolbar__icon-button
                    catalog-toolbar__icon-button--expand-table
                " data-catalog-expand-table aria-pressed="false" aria-label="Mở rộng danh sách"
                title="Mở rộng danh sách">
                <i class="fa-solid fa-arrows-left-right" aria-hidden="true">
                </i>
            </button>

            <button type="button" class="
                    catalog-toolbar__icon-button
                    catalog-toolbar__icon-button--expand-info
                " data-catalog-expand-info aria-pressed="false" aria-label="Mở rộng thông tin"
                title="Mở rộng thông tin">
                <i class="fa-solid fa-table-columns" aria-hidden="true">
                </i>
            </button>

            {{#unless hideCreateButton}}
                <button type="button" id="{{createButtonId}}"
                    class="catalog-toolbar__button catalog-toolbar__button--primary" data-catalog-create>
                    <span aria-hidden="true">
                        +
                    </span>
                    <span>
                        Thêm mới
                    </span>
                </button>
            {{/unless}}
        </div>
    </div>
</header>