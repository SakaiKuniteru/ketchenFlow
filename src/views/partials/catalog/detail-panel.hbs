<section id="{{#if panelId}}{{panelId}}{{else}}detailPanelContent{{/if}}"
    class="detail-panel {{#if panelClass}}{{panelClass}}{{/if}}" data-detail-panel data-mode="closed">

    {{> catalog/detail-header
        title=title
        subtitle=subtitle
    }}

    <div class="detail-panel__body">

        <form id="{{#if formId}}{{formId}}{{else}}catalogForm{{/if}}" class="detail-panel__form" data-catalog-form
            autocomplete="off" novalidate>

            <input type="hidden" id="{{formId}}Id" name="id" data-record-id>

            <div class="detail-panel__form-content">

                {{#if formPartial}}

                    {{> (lookup . "formPartial")}}

                {{else}}

                    <div class="catalog-page__notice">
                        Chưa cấu hình form cho danh mục này.
                    </div>

                {{/if}}

            </div>

            {{> catalog/form-actions}}

        </form>

    </div>

</section>